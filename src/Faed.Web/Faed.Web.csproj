<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-Faed.Web-a316e60c-7f00-4d12-aed4-4ea6e3ea74cc</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.11" />
    <!-- EF Core design-time only, so `dotnet ef` can use Faed.Web as the startup project.
         The provider (SqlServer) and migrations live in Faed.Infrastructure. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Faed.Application\Faed.Application.csproj" />
    <ProjectReference Include="..\Faed.Infrastructure\Faed.Infrastructure.csproj" />
  </ItemGroup>

</Project>
