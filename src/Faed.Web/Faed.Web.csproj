<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-Faed.Web-a316e60c-7f00-4d12-aed4-4ea6e3ea74cc</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Single-project organized MVC: entities, EF Core, services, migrations and the
         web host all live in this one project . -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.510.8" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Development-only demo product photography (tools/demo-images/generate-demo-images.ps1,
         Data/Seed/DemoDataSeeder.cs). Copied next to the built app so DemoAssets.LoadImage can
         read it from disk under both "dotnet run" and a built bin output; excluded from
         "dotnet publish" output since it is never needed outside local Development. -->
    <Content Include="Data\Seed\Assets\Images\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- LocalFileStorage (Services/Storage/LocalFileStorage.cs) writes merchant verification
         documents and listing images to App_Data/private-storage at runtime, under the content
         root. The SDK's default item globs would otherwise pick up each new file as a project
         Content/None item; Visual Studio's file watcher then treats the running app's own
         upload as an external project change and reloads the project, killing the debug
         session mid-request. App_Data is already git-ignored — exclude it from MSBuild's
         globs too so writing to it is never mistaken for an edit to the project. -->
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
  </ItemGroup>

</Project>
