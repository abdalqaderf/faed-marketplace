@model BuyerOrderDetailPageModel
@{
    var order = Model.Order;
    ViewData["Title"] = $"Order — {order.MerchantBusinessName}";
}

<div class="faed-page">
    <nav class="faed-breadcrumb" aria-label="Breadcrumb">
        <a asp-action="Index">My orders</a>
        <span aria-hidden="true">/</span>
        <span>@AmmanTime.FormatDate(order.CreatedAtUtc)</span>
    </nav>

    <div class="faed-page__header">
        <div>
            <h1 class="faed-page__title">Order from @order.MerchantBusinessName</h1>
            <p class="faed-page__subtitle">Placed @AmmanTime.FormatDateTime(order.CreatedAtUtc) (Amman time).</p>
        </div>
        <div class="faed-page__actions">
            <span class="@OrderStatusDisplay.BadgeClass(order.Status)">@OrderStatusDisplay.Label(order.Status)</span>
        </div>
    </div>

    @if (order.Status == OrderStatus.Pending && order.ReservationExpiresAtUtc is { } expires)
    {
        <div class="faed-alert faed-alert--info" role="status">
            Your items are reserved until about @AmmanTime.FormatDateTime(expires). If the merchant hasn't
            confirmed by then, the order is cancelled automatically and the stock is released.
        </div>
    }

    @if (!string.IsNullOrEmpty(order.StatusReason) && order.Status is OrderStatus.Cancelled or OrderStatus.NoShow)
    {
        <div class="faed-alert faed-alert--error" role="status">@order.StatusReason</div>
    }

    <div class="faed-panel">
        <h2 class="faed-panel__title">Items</h2>
        <div class="faed-table-wrap">
            <table class="faed-table">
                <thead>
                    <tr>
                        <th scope="col">Item</th>
                        <th scope="col">Condition</th>
                        <th scope="col">Unit price</th>
                        <th scope="col">Qty</th>
                        <th scope="col">Line total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in order.Items)
                    {
                        <tr>
                            <td>
                                @if (item.ListingSlug is { } slug)
                                {
                                    <a asp-area="" asp-controller="Listing" asp-action="Details" asp-route-slug="@slug">@item.ListingTitle</a>
                                }
                                else
                                {
                                    @item.ListingTitle
                                }
                                <div class="faed-field__hint">@item.VariantSnapshot</div>
                                @if (!string.IsNullOrEmpty(item.DiscountReasonSnapshot))
                                {
                                    <div class="faed-field__hint">Why discounted: @item.DiscountReasonSnapshot</div>
                                }
                            </td>
                            <td>@item.ConditionSnapshot</td>
                            <td>JOD @item.UnitPrice.ToString("0.000")</td>
                            <td>@item.Quantity</td>
                            <td>JOD @item.LineTotal.ToString("0.000")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><th scope="row" colspan="4">Subtotal</th><td>JOD @order.Subtotal.ToString("0.000")</td></tr>
                    <tr><th scope="row" colspan="4">@OrderStatusDisplay.FulfillmentLabel(order.FulfillmentType) fee</th><td>JOD @order.DeliveryFeeSnapshot.ToString("0.000")</td></tr>
                    <tr><th scope="row" colspan="4">Total</th><td><strong>JOD @order.Total.ToString("0.000")</strong></td></tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="faed-panel">
        <h2 class="faed-panel__title">Fulfilment &amp; contact</h2>
        <dl class="faed-details">
            <dt>Method</dt>
            <dd>@OrderStatusDisplay.FulfillmentLabel(order.FulfillmentType)</dd>
            <dt>Details</dt>
            <dd>@order.FulfillmentSnapshot</dd>
            @if (!string.IsNullOrWhiteSpace(order.DeliveryAddressText))
            {
                <dt>Delivery address</dt>
                <dd>@order.DeliveryAddressText</dd>
            }
            <dt>Contact</dt>
            <dd>@order.ContactName · @order.ContactPhone</dd>
            @if (!string.IsNullOrWhiteSpace(order.BuyerNote))
            {
                <dt>Your note</dt>
                <dd>@order.BuyerNote</dd>
            }
        </dl>
    </div>

    @if (order.BuyerCanConfirmReceipt)
    {
        <div class="faed-panel">
            <h2 class="faed-panel__title">Confirm receipt</h2>
            <p class="faed-panel__hint">
                Once you have collected or received your order, confirm it here. This completes the
                order and lets you review the merchant.
            </p>
            <form asp-action="ConfirmReceipt" asp-route-id="@order.Id" method="post">
                <button type="submit" class="faed-btn faed-btn--primary">I've received this order</button>
            </form>
        </div>
    }

    @if (Model.ActiveDispute is not null || Model.PastDisputes.Count > 0 || Model.CanRaiseDispute)
    {
        <div class="faed-panel">
            <h2 class="faed-panel__title">Disputes</h2>
            @if (Model.ActiveDispute is { } dispute)
            {
                <p class="faed-panel__hint">
                    <span class="@DisputeStatusDisplay.BadgeClass(dispute.Status)">@DisputeStatusDisplay.Label(dispute.Status)</span>
                    &nbsp;@DisputeStatusDisplay.ReasonLabel(dispute.ReasonCode) · raised @AmmanTime.FormatDate(dispute.CreatedAtUtc)
                </p>
                <a class="faed-btn faed-btn--ghost" asp-controller="Disputes" asp-action="Details" asp-route-id="@dispute.Id">
                    View dispute
                </a>
            }
            @if (Model.PastDisputes.Count > 0)
            {
                <ul class="faed-field__hint">
                    @foreach (var past in Model.PastDisputes)
                    {
                        <li>
                            <a asp-controller="Disputes" asp-action="Details" asp-route-id="@past.Id">
                                @DisputeStatusDisplay.ReasonLabel(past.ReasonCode)
                            </a>
                            — @DisputeStatusDisplay.Label(past.Status), @AmmanTime.FormatDate(past.CreatedAtUtc)
                        </li>
                    }
                </ul>
            }
            @if (Model.CanRaiseDispute)
            {
                <p class="faed-panel__hint">
                    If the item was not as described, defective, missing parts or never arrived, you can raise a
                    dispute. An administrator will review it.
                </p>
                <a class="faed-btn faed-btn--ghost" asp-controller="Disputes" asp-action="Create" asp-route-orderId="@order.Id">
                    Raise a dispute
                </a>
            }
        </div>
    }

    @if (Model.ReviewEligibility is { ExistingReview: { } mine })
    {
        <div class="faed-panel">
            <h2 class="faed-panel__title">Your review</h2>
            <p><strong aria-hidden="true">@DisputeStatusDisplay.Stars(mine.Rating)</strong> @mine.Rating / 5</p>
            @if (!string.IsNullOrWhiteSpace(mine.Comment))
            {
                <p class="faed-prewrap">@mine.Comment</p>
            }
            <p class="faed-panel__hint">Posted @AmmanTime.FormatDate(mine.CreatedAtUtc).</p>
        </div>
    }
    else if (Model.ReviewEligibility is { CanReview: true })
    {
        <div class="faed-panel">
            <h2 class="faed-panel__title">Review @order.MerchantBusinessName</h2>
            <p class="faed-panel__hint">Your order is complete. Leave a rating to help other buyers.</p>
            <form asp-action="Review" asp-route-id="@order.Id" method="post">
                <div class="faed-field">
                    <label class="faed-field__label" for="review-rating">Rating (1–5)</label>
                    <input class="faed-input faed-input--quantity" id="review-rating" name="Rating" type="number" min="1" max="5" value="5" required />
                </div>
                <div class="faed-field">
                    <label class="faed-field__label" for="review-comment">Comment (optional)</label>
                    <textarea class="faed-input" id="review-comment" name="Comment" rows="3" maxlength="2000"></textarea>
                </div>
                <button type="submit" class="faed-btn faed-btn--primary">Post review</button>
            </form>
        </div>
    }

    @if (order.BuyerCanCancel)
    {
        <div class="faed-panel">
            <h2 class="faed-panel__title">Cancel this order</h2>
            <p class="faed-panel__hint">
                You can cancel while the order is still awaiting confirmation or just confirmed. The reserved
                stock is released straight away.
            </p>
            <form asp-action="Cancel" asp-route-id="@order.Id" method="post">
                <div class="faed-field">
                    <label class="faed-field__label" for="cancel-reason">Reason (optional)</label>
                    <input class="faed-input" id="cancel-reason" name="reason" maxlength="500" />
                </div>
                <button type="submit" class="faed-btn faed-btn--danger">Cancel order</button>
            </form>
        </div>
    }
</div>
