@model BuyerOrderDetailPageModel
@{
    var order = Model.Order;
    ViewData["Title"] = $"Reservation #{order.Reference}";
    var orderReference = order.Reference;
    var isTerminalProblem = order.Status is OrderStatus.Cancelled or OrderStatus.NoShow;
    var firstItem = order.Items.Count > 0 ? order.Items[0].ListingTitle : "my item";
    var whatsApp = order.ContactRevealed
        ? WhatsAppLink.Build(order.MerchantPhone, $"Hi, I reserved {firstItem} on Faed. Order #{order.Reference}")
        : null;
}

<div class="faed-page faed-page--wide faed-buyer-page faed-order-detail-page">
    <nav class="faed-breadcrumb" aria-label="Breadcrumb">
        <a asp-action="Index">My orders</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Reservation #@orderReference</span>
    </nav>

    <header class="faed-order-detail-hero">
        <div>
            <p class="faed-kicker">Reservation #@orderReference</p>
            <h1>Reserved from @order.MerchantBusinessName</h1>
            <p>Placed @AmmanTime.FormatDateTime(order.CreatedAtUtc) · Pickup, pay cash</p>
        </div>
        <div class="faed-order-detail-hero__status">
            <span>Status</span>
            <span class="@OrderStatusDisplay.BadgeClass(order.Status)">@OrderStatusDisplay.Label(order.Status)</span>
        </div>
    </header>

    @if (order.Status == OrderStatus.Pending && order.ReservationExpiresAtUtc is { } expires)
    {
        <div class="faed-order-callout faed-order-callout--info" role="status">
            <strong>The item is held for you.</strong>
            <span>The shop has until about @AmmanTime.FormatDateTime(expires) to confirm. If it doesn't, the reservation is cancelled automatically and you lose nothing.</span>
        </div>
    }
    else if (order.Status == OrderStatus.Confirmed)
    {
        <div class="faed-order-callout faed-order-callout--info" role="status">
            <strong>Confirmed — go and collect it.</strong>
            <span>Pick it up and pay cash within 48 hours. After that the reservation is released.</span>
        </div>
    }
    else if (order.Status == OrderStatus.ReadyForPickup)
    {
        <div class="faed-order-callout faed-order-callout--info" role="status">
            <strong>Ready for pickup.</strong>
            <span>Collect it within 72 hours. After that the reservation is closed and the stock released.</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(order.StatusReason) && isTerminalProblem)
    {
        <div class="faed-order-callout faed-order-callout--danger" role="status">
            <strong>@OrderStatusDisplay.Label(order.Status)</strong>
            <span>@order.StatusReason</span>
        </div>
    }

    @if (!isTerminalProblem)
    {
        <ol class="faed-order-progress" aria-label="Order progress">
            <li class="is-reached">
                <span>1</span><strong>Placed</strong><small>Waiting for merchant</small>
            </li>
            <li class="@(order.Status is OrderStatus.Confirmed or OrderStatus.ReadyForPickup or OrderStatus.OutForDelivery or OrderStatus.Completed ? "is-reached" : "")">
                <span>2</span><strong>Confirmed</strong><small>Merchant accepted</small>
            </li>
            <li class="@(order.Status is OrderStatus.ReadyForPickup or OrderStatus.OutForDelivery or OrderStatus.Completed ? "is-reached" : "")">
                <span>3</span><strong>Ready</strong><small>Ready for pickup</small>
            </li>
            <li class="@(order.Status == OrderStatus.Completed ? "is-reached" : "")">
                <span>4</span><strong>Collected</strong><small>Picked up and paid</small>
            </li>
        </ol>
    }

    <div class="faed-order-detail-layout">
        <main class="faed-order-detail-main">
            <section class="faed-buyer-surface" aria-labelledby="order-items-title">
                <div class="faed-buyer-surface__header">
                    <div>
                        <p class="faed-kicker">Purchase details</p>
                        <h2 id="order-items-title">Items</h2>
                    </div>
                    <strong>@order.Items.Sum(item => item.Quantity) unit@(order.Items.Sum(item => item.Quantity) == 1 ? "" : "s")</strong>
                </div>

                <div class="faed-order-items">
                    @foreach (var item in order.Items)
                    {
                        <article class="faed-order-item">
                            <div class="faed-order-item__identity">
                                @if (item.ListingSlug is { } slug)
                                {
                                    <a asp-area="" asp-controller="Listing" asp-action="Details" asp-route-slug="@slug">@item.ListingTitle</a>
                                }
                                else
                                {
                                    <strong>@item.ListingTitle</strong>
                                }
                                <span>@item.VariantSnapshot</span>
                                <span>Condition · @item.ConditionSnapshot</span>
                                @if (!string.IsNullOrEmpty(item.DiscountReasonSnapshot))
                                {
                                    <span>Why discounted · @item.DiscountReasonSnapshot</span>
                                }
                            </div>
                            <div class="faed-order-item__numbers">
                                <div><span>Qty</span><strong>@item.Quantity</strong></div>
                                <div><span>Unit</span><strong>JOD @item.UnitPrice.ToString("0.000")</strong></div>
                                <div><span>Line total</span><strong>JOD @item.LineTotal.ToString("0.000")</strong></div>
                            </div>
                        </article>
                    }
                </div>
            </section>

            @if (order.BuyerCanConfirmReceipt)
            {
                <section class="faed-buyer-action-card faed-buyer-action-card--primary" aria-labelledby="confirm-receipt-title">
                    <div>
                        <p class="faed-kicker">Your next step</p>
                        <h2 id="confirm-receipt-title">Confirm when the order is in your hands.</h2>
                        <p>This completes the order and unlocks the ability to review the merchant.</p>
                    </div>
                    <form asp-action="ConfirmReceipt" asp-route-id="@order.Id" method="post">
                        <button type="submit" class="faed-btn faed-btn--light">I've received this order</button>
                    </form>
                </section>
            }

            @if (Model.ReviewEligibility is { ExistingReview: { } mine })
            {
                <section class="faed-buyer-surface" aria-labelledby="existing-review-title">
                    <div class="faed-buyer-surface__header">
                        <div>
                            <p class="faed-kicker">Your feedback</p>
                            <h2 id="existing-review-title">Your review</h2>
                        </div>
                        <span class="faed-review-score"><strong aria-hidden="true">@ReviewDisplay.Stars(mine.Rating)</strong> @mine.Rating / 5</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(mine.Comment))
                    {
                        <p class="faed-prewrap faed-review-copy">@mine.Comment</p>
                    }
                    <p class="faed-panel__hint">Posted @AmmanTime.FormatDate(mine.CreatedAtUtc).</p>
                </section>
            }
            else if (Model.ReviewEligibility is { CanReview: true })
            {
                <section class="faed-buyer-surface" aria-labelledby="leave-review-title">
                    <div class="faed-buyer-surface__header">
                        <div>
                            <p class="faed-kicker">Share your experience</p>
                            <h2 id="leave-review-title">Review @order.MerchantBusinessName</h2>
                        </div>
                    </div>
                    <p class="faed-panel__hint">Your order is complete. A clear rating helps other buyers judge the merchant.</p>
                    <form asp-action="Review" asp-route-id="@order.Id" method="post" class="faed-review-form">
                        <div class="faed-field">
                            <label class="faed-field__label" for="review-rating">Rating (1–5)</label>
                            <input class="faed-input faed-input--quantity" id="review-rating" name="Rating" type="number" min="1" max="5" value="5" required />
                        </div>
                        <div class="faed-field faed-review-form__comment">
                            <label class="faed-field__label" for="review-comment">Comment <span class="faed-optional">Optional</span></label>
                            <textarea class="faed-input" id="review-comment" name="Comment" rows="3" maxlength="2000" placeholder="What would another buyer find useful to know?"></textarea>
                        </div>
                        <button type="submit" class="faed-btn faed-btn--primary">Post review</button>
                    </form>
                </section>
            }
        </main>

        <aside class="faed-order-summary">
            <section class="faed-order-summary__card" aria-labelledby="order-summary-title">
                <p class="faed-kicker">Summary</p>
                <h2 id="order-summary-title">Order total</h2>
                <dl class="faed-order-money">
                    <div><dt>Subtotal</dt><dd>JOD @order.Subtotal.ToString("0.000")</dd></div>
                    <div class="faed-order-money__total"><dt>Total</dt><dd>JOD @order.Total.ToString("0.000")</dd></div>
                </dl>
            </section>

            <section class="faed-order-summary__card" aria-labelledby="fulfilment-summary-title">
                <p class="faed-kicker">Pickup</p>
                <h2 id="fulfilment-summary-title">Collect from @order.MerchantBusinessName</h2>
                <dl class="faed-order-summary-list">
                    @if (order.ContactRevealed)
                    {
                        <div><dt>Where</dt><dd>@order.FulfillmentSnapshot</dd></div>
                        @if (!string.IsNullOrWhiteSpace(order.MerchantPhone))
                        {
                            <div><dt>Shop phone</dt><dd>@order.MerchantPhone</dd></div>
                        }
                    }
                    else
                    {
                        <div><dt>Area</dt><dd>@order.PickupArea</dd></div>
                        <div><dt>Full address</dt><dd>Revealed once the shop confirms your reservation.</dd></div>
                    }
                    <div><dt>Your contact</dt><dd>@order.ContactName<br />@order.ContactPhone</dd></div>
                    @if (!string.IsNullOrWhiteSpace(order.BuyerNote))
                    {
                        <div><dt>Your note</dt><dd>@order.BuyerNote</dd></div>
                    }
                </dl>
                @if (whatsApp is not null)
                {
                    <a class="faed-btn faed-btn--ghost faed-whatsapp-btn" href="@whatsApp" target="_blank" rel="noopener">
                        @FaedIcon.Render("chat", "faed-icon") Message the shop on WhatsApp
                    </a>
                }
                <a class="faed-order-summary__merchant" asp-area="" asp-controller="Store" asp-action="Index" asp-route-slug="@order.MerchantSlug">
                    Visit @order.MerchantBusinessName @FaedIcon.Render("arrow-right", "faed-icon")
                </a>
            </section>

            @if (order.BuyerCanCancel)
            {
                <details class="faed-order-danger">
                    <summary>Need to cancel this order?</summary>
                    <div>
                        <p>You can cancel while the order is awaiting confirmation or confirmed. Reserved stock is released immediately.</p>
                        <form asp-action="Cancel" asp-route-id="@order.Id" method="post">
                            <div class="faed-field">
                                <label class="faed-field__label" for="cancel-reason">Reason <span class="faed-optional">Optional</span></label>
                                <input class="faed-input" id="cancel-reason" name="reason" maxlength="500" />
                            </div>
                            <button type="submit" class="faed-btn faed-btn--danger">Cancel order</button>
                        </form>
                    </div>
                </details>
            }
        </aside>
    </div>
</div>
