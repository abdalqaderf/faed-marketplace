@model BuyerOrderListPageModel
@{
    ViewData["Title"] = "My orders";
}

<div class="faed-page faed-page--wide faed-buyer-page faed-orders-page">
    <header class="faed-buyer-heading faed-buyer-heading--with-actions">
        <div>
            <p class="faed-kicker">Your purchases</p>
            <h1>My orders</h1>
            <p>Track every retail order, see what happens next, and open the full order when you need to take action.</p>
        </div>
        <a class="faed-btn faed-btn--primary" asp-area="" asp-controller="Shop" asp-action="Index">Browse marketplace</a>
    </header>

    @if (Model.Orders.TotalCount == 0)
    {
        <section class="faed-buyer-empty">
            <span class="faed-buyer-empty__mark" aria-hidden="true">01</span>
            <p class="faed-kicker">Nothing to track yet</p>
            <h2>Your first order will appear here.</h2>
            <p>When you place an order, this page becomes your hub for merchant confirmation, fulfilment, receipt, reviews, and disputes.</p>
            <a class="faed-btn faed-btn--primary" asp-area="" asp-controller="Shop" asp-action="Index">Start shopping</a>
        </section>
    }
    else
    {
        <div class="faed-order-list" role="list">
            @foreach (var order in Model.Orders.Items)
            {
                <article class="faed-order-card" role="listitem">
                    <a class="faed-order-card__main" asp-action="Details" asp-route-id="@order.Id" aria-label="Open order from @order.Counterparty">
                        <div class="faed-order-card__heading">
                            <div>
                                <span class="faed-order-card__date">Placed @AmmanTime.FormatDate(order.CreatedAtUtc)</span>
                                <h2>@order.Counterparty</h2>
                            </div>
                            <span class="@OrderStatusDisplay.BadgeClass(order.Status)">@OrderStatusDisplay.Label(order.Status)</span>
                        </div>

                        <div class="faed-order-card__facts">
                            <div><span>Items</span><strong>@order.TotalUnits unit@(order.TotalUnits == 1 ? "" : "s")</strong></div>
                            <div><span>Total</span><strong>JOD @order.Total.ToString("0.000")</strong></div>
                            <div><span>Fulfilment</span><strong>@OrderStatusDisplay.FulfillmentLabel(order.FulfillmentType)</strong></div>
                        </div>

                        @if (order.Status == OrderStatus.Pending && order.ReservationExpiresAtUtc is { } expires)
                        {
                            <p class="faed-order-card__context">Stock reserved while the merchant confirms · until about @AmmanTime.FormatDateTime(expires)</p>
                        }
                        else if (order.Status == OrderStatus.ReadyForPickup)
                        {
                            <p class="faed-order-card__context">Your order is ready to collect. Open it for the pickup details.</p>
                        }
                        else if (order.Status == OrderStatus.OutForDelivery)
                        {
                            <p class="faed-order-card__context">The merchant has marked this order as out for delivery.</p>
                        }
                        else if (order.Status == OrderStatus.Completed)
                        {
                            <p class="faed-order-card__context">Order completed. Your order page contains review and dispute history.</p>
                        }
                    </a>
                    <a class="faed-order-card__open" asp-action="Details" asp-route-id="@order.Id">
                        View order <span aria-hidden="true">→</span>
                    </a>
                </article>
            }
        </div>

        <partial name="_Pagination" model='PaginationViewModel.From(Model.Orders, "Index", itemNoun: "order")' />
    }
</div>
