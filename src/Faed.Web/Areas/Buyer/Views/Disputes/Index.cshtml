@model BuyerDisputeListPageModel
@{
    ViewData["Title"] = "My disputes";
}

<div class="faed-page faed-page--wide faed-buyer-page faed-disputes-page">
    <header class="faed-buyer-heading faed-buyer-heading--with-actions">
        <div>
            <p class="faed-kicker">Buyer protection</p>
            <h1>My disputes</h1>
            <p>Follow cases you have raised about an order, including their current review status and any final outcome.</p>
        </div>
        <a class="faed-btn faed-btn--ghost" asp-controller="Orders" asp-action="Index">View my orders</a>
    </header>

    <div class="faed-buyer-guidance">
        <span aria-hidden="true">i</span>
        <p>Start a new dispute from the relevant order page. That keeps the case tied to the correct transaction and its current eligibility rules.</p>
    </div>

    @if (Model.Disputes.TotalCount == 0)
    {
        <section class="faed-buyer-empty">
            <span class="faed-buyer-empty__mark" aria-hidden="true">@FaedIcon.Render("check-circle", "faed-icon")</span>
            <p class="faed-kicker">No open history</p>
            <h2>You have not raised any disputes.</h2>
            <p>If something goes wrong with an eligible order, open that order and choose <strong>Raise a dispute</strong>.</p>
            <a class="faed-btn faed-btn--primary" asp-controller="Orders" asp-action="Index">Open my orders</a>
        </section>
    }
    else
    {
        <div class="faed-dispute-list" role="list">
            @foreach (var dispute in Model.Disputes.Items)
            {
                <article class="faed-dispute-card" role="listitem">
                    <a class="faed-dispute-card__main" asp-action="Details" asp-route-id="@dispute.Id">
                        <div class="faed-dispute-card__heading">
                            <div>
                                <span>@DisputeStatusDisplay.TransactionLabel(dispute.TransactionType) · @dispute.TransactionReference</span>
                                <h2>@DisputeStatusDisplay.ReasonLabel(dispute.ReasonCode)</h2>
                            </div>
                            <span class="@DisputeStatusDisplay.BadgeClass(dispute.Status)">@DisputeStatusDisplay.Label(dispute.Status)</span>
                        </div>
                        <dl class="faed-dispute-card__facts">
                            <div><dt>Merchant</dt><dd>@dispute.CounterpartyName</dd></div>
                            <div><dt>Raised</dt><dd>@AmmanTime.FormatDate(dispute.CreatedAtUtc)</dd></div>
                            <div><dt>Last updated</dt><dd>@AmmanTime.FormatDate(dispute.UpdatedAtUtc)</dd></div>
                        </dl>
                    </a>
                    <a class="faed-dispute-card__open" asp-action="Details" asp-route-id="@dispute.Id">View case @FaedIcon.Render("arrow-right", "faed-icon")</a>
                </article>
            }
        </div>

        <partial name="_Pagination" model='PaginationViewModel.From(Model.Disputes, "Index", itemNoun: "dispute")' />
    }
</div>
