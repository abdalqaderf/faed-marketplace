@model string
@using Faed.Web.Authorization
@using Faed.Web.Services.Merchants
@inject IMerchantVerificationService MerchantVerification
@{
    var active = Model ?? string.Empty;

    // Link visibility here must mirror the ApprovedMerchant/RegisteredMerchant policies that
    // actually gate these controllers (Authorization/FaedPolicies.cs) — otherwise a merchant
    // whose application is still Draft/PendingReview/Rejected/Suspended sees a sidebar link that
    // then sends them to "you are not authorized" when clicked. Verification is the one
    // destination with no merchant-state gate (plain [Authorize]), so it always shows;
    // Subscription and Listings need a registered, non-suspended profile (RegisteredMerchant);
    // Orders, Reviews, Analytics and Store Settings need an approved one (ApprovedMerchant).
    var userId = User.RequireUserId();
    var isRegisteredMerchant = await MerchantVerification.IsRegisteredMerchantAsync(userId);
    var isApprovedMerchant = await MerchantVerification.IsApprovedMerchantAsync(userId);

    bool CanShow(string section) => section switch
    {
        "Verification" => true,
        "Subscription" or "Listings" => isRegisteredMerchant,
        _ => isApprovedMerchant,
    };

    var groups = new[]
    {
        new
        {
            Label = "Account",
            Links = new[]
            {
                (Section: "Verification", Controller: "Verification", Label: "Verification", Icon: "shield-check"),
                (Section: "Subscription", Controller: "Subscription", Label: "Subscription", Icon: "exchange")
            }
        },
        new
        {
            Label = "Sell",
            Links = new[]
            {
                (Section: "Listings", Controller: "Listings", Label: "Listings", Icon: "tag")
            }
        },
        new
        {
            Label = "Orders & commerce",
            Links = new[]
            {
                (Section: "Orders", Controller: "Orders", Label: "Orders", Icon: "receipt")
            }
        },
        new
        {
            Label = "Customers",
            Links = new[]
            {
                (Section: "Reviews", Controller: "Reviews", Label: "Reviews", Icon: "star")
            }
        },
        new
        {
            Label = "Insights",
            Links = new[]
            {
                (Section: "Analytics", Controller: "Analytics", Label: "Analytics", Icon: "chart")
            }
        },
        new
        {
            Label = "Settings",
            Links = new[]
            {
                (Section: "StoreSettings", Controller: "StoreSettings", Label: "Store Settings", Icon: "gear")
            }
        }
    };

    var visibleGroups = groups
        .Select(group => new { group.Label, Links = group.Links.Where(l => CanShow(l.Section)).ToArray() })
        .Where(group => group.Links.Length > 0)
        .ToArray();

    var activeLabel = active switch
    {
        "Verification" => "Verification",
        "Subscription" => "Subscription",
        "Listings" => "Listings",
        "Orders" => "Orders",
        "Reviews" => "Reviews",
        "Analytics" => "Analytics",
        "StoreSettings" => "Store Settings",
        _ => "Merchant Center"
    };
}

<div class="faed-merchant-workspace-nav">
    <aside class="faed-merchant-sidebar" aria-label="Merchant workspace navigation">
        <div class="faed-merchant-sidebar__brand">
            <span class="faed-merchant-sidebar__eyebrow">Seller workspace</span>
            <strong>Merchant Center</strong>
            <span>Manage listings, commerce, trust, and store operations.</span>
        </div>

        <nav class="faed-merchant-sidebar__nav" aria-label="Merchant sections">
            @foreach (var group in visibleGroups)
            {
                <div class="faed-merchant-sidebar__group">
                    <span class="faed-merchant-sidebar__group-label">@group.Label</span>
                    @foreach (var link in group.Links)
                    {
                        <a class="faed-merchant-sidebar__link @(active == link.Section ? "is-active" : "")"
                           aria-current="@(active == link.Section ? "page" : null)"
                           asp-area="Merchant" asp-controller="@link.Controller" asp-action="Index">
                            @FaedIcon.Render(link.Icon, "faed-icon faed-workspace-nav__icon")
                            <span>@link.Label</span>
                        </a>
                    }
                </div>
            }
        </nav>
    </aside>

    <div class="faed-merchant-mobilebar">
        <div class="faed-merchant-mobilebar__context">
            <span>Merchant Center</span>
            <strong>@activeLabel</strong>
        </div>
        <button class="faed-btn faed-btn--ghost faed-merchant-mobilebar__toggle" type="button"
                data-bs-toggle="offcanvas" data-bs-target="#faed-merchant-navigation"
                aria-controls="faed-merchant-navigation" aria-label="Open merchant navigation">
            @FaedIcon.Render("menu", "faed-icon")
            <span>Menu</span>
        </button>
    </div>

    <div class="offcanvas offcanvas-start faed-merchant-drawer" tabindex="-1" id="faed-merchant-navigation"
         aria-labelledby="faed-merchant-navigation-label">
        <div class="offcanvas-header faed-merchant-drawer__header">
            <div>
                <span class="faed-merchant-sidebar__eyebrow">Seller workspace</span>
                <h2 class="offcanvas-title" id="faed-merchant-navigation-label">Merchant Center</h2>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close merchant navigation"></button>
        </div>
        <div class="offcanvas-body faed-merchant-drawer__body">
            <nav class="faed-merchant-sidebar__nav" aria-label="Merchant sections mobile">
                @foreach (var group in visibleGroups)
                {
                    <div class="faed-merchant-sidebar__group">
                        <span class="faed-merchant-sidebar__group-label">@group.Label</span>
                        @foreach (var link in group.Links)
                        {
                            <a class="faed-merchant-sidebar__link @(active == link.Section ? "is-active" : "")"
                               aria-current="@(active == link.Section ? "page" : null)"
                               asp-area="Merchant" asp-controller="@link.Controller" asp-action="Index"
                               data-bs-dismiss="offcanvas">
                                @FaedIcon.Render(link.Icon, "faed-icon faed-workspace-nav__icon")
                                <span>@link.Label</span>
                            </a>
                        }
                    </div>
                }
            </nav>
        </div>
    </div>
</div>
