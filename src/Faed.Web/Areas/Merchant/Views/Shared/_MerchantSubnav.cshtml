@model string
@{
    var active = Model ?? string.Empty;
    (string Section, string Area, string Controller, string Label)[] links =
    {
        ("Verification", "Merchant", "Verification", "Verification"),
        ("Listings", "Merchant", "Listings", "Listings"),
        ("Inventory", "Merchant", "Inventory", "Inventory"),
        ("Orders", "Merchant", "Orders", "B2C Orders"),
        ("Offers", "Merchant", "Offers", "B2B Offers"),
        ("Deals", "Merchant", "Deals", "B2B Deals"),
        ("Disputes", "Merchant", "Disputes", "Disputes"),
        ("Reviews", "Merchant", "Reviews", "Reviews"),
        ("Analytics", "Merchant", "Analytics", "Analytics"),
        ("StoreSettings", "Merchant", "StoreSettings", "Store settings"),
    };
}
<div class="faed-workspace-nav faed-workspace-nav--merchant">
    <div class="faed-workspace-nav__identity">
        <span class="faed-workspace-nav__eyebrow">Seller workspace</span>
        <strong>Merchant Center</strong>
    </div>
    <nav class="faed-subnav faed-subnav--workspace" aria-label="Merchant sections">
        @foreach (var link in links)
        {
            <a class="@(active == link.Section ? "is-active" : "")" aria-current="@(active == link.Section ? "page" : null)"
               asp-area="@link.Area" asp-controller="@link.Controller" asp-action="Index">@link.Label</a>
        }
    </nav>
</div>
