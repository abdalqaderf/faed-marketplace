@model ListingListPageModel
@{
    ViewData["Title"] = "Listings";

    var tabs = new (MerchantListingFilter Value, string Label)[]
    {
        (MerchantListingFilter.NeedsAttention, "Needs attention"),
        (MerchantListingFilter.All, "All"),
        (MerchantListingFilter.Draft, "Draft"),
        (MerchantListingFilter.PendingReview, "Pending review"),
        (MerchantListingFilter.Live, "Live"),
        (MerchantListingFilter.Rejected, "Rejected"),
    };
}

<div class="faed-page faed-page--wide">
    <partial name="_MerchantSubnav" model="@("Listings")" />

    <div class="faed-page__header">
        <div>
            <h1 class="faed-page__title">Listings</h1>
            <p class="faed-page__subtitle">Manage your marketplace listings, variants, availability, and stock.</p>
        </div>
        <div class="faed-page__actions">
            <a class="faed-btn faed-btn--primary" asp-action="Create">@FaedIcon.Render("plus", "faed-icon")<span>New listing</span></a>
        </div>
    </div>

    <nav class="faed-subnav" aria-label="Filter listings">
        @foreach (var (value, label) in tabs)
        {
            <a class="@(Model.Filter == value ? "is-active" : "")" asp-action="Index" asp-route-filter="@value">@label</a>
        }
    </nav>

    @if (Model.Items.TotalCount == 0)
    {
        <div class="faed-empty">
            <div class="faed-empty__title">No listings here yet</div>
            <div>
                @(Model.Filter == MerchantListingFilter.All
                    ? "Create your first listing to start selling."
                    : "Nothing matches this filter right now.")
            </div>
            <div class="faed-empty__actions">
                @if (Model.Filter == MerchantListingFilter.All)
                {
                    <a class="faed-btn faed-btn--primary faed-btn--sm" asp-action="Create">@FaedIcon.Render("plus", "faed-icon")<span>Create listing</span></a>
                }
                else
                {
                    <a class="faed-btn faed-btn--ghost faed-btn--sm" asp-action="Index" asp-route-filter="@MerchantListingFilter.All">View all listings</a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="faed-table-wrap">
            <table class="faed-table">
                <thead>
                    <tr>
                        <th scope="col">Listing</th>
                        <th scope="col">Status</th>
                        <th scope="col">Category</th>
                        <th scope="col">Condition</th>
                        <th scope="col">Retail price</th>
                        <th scope="col">Variants</th>
                        <th scope="col">Available</th>
                        <th scope="col">Updated</th>
                        <th scope="col"><span class="visually-hidden">Action</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items.Items)
                    {
                        <tr>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id">@item.Title</a>
                                @if (item.HasDefectPhotos)
                                {
                                    <span class="faed-badge faed-badge--info" title="Has defect photos">Defect disclosed</span>
                                }
                            </td>
                            <td>
                                <span class="@ListingStatusDisplay.BadgeClass(item.Status)">@ListingStatusDisplay.Label(item.Status)</span>
                                @if (item.Status == ListingStatus.Rejected && !string.IsNullOrEmpty(item.LatestReviewNote))
                                {
                                    <div class="faed-doclist__meta">@item.LatestReviewNote</div>
                                }
                            </td>
                            <td>@item.CategoryName</td>
                            <td>Grade @item.ConditionCode</td>
                            <td>@(item.RetailPrice is { } price ? $"JOD {price:0.000}" : "—")</td>
                            <td>@item.VariantCount</td>
                            <td>@item.AvailableUnits</td>
                            <td>@AmmanTime.FormatDate(item.UpdatedAtUtc)</td>
                            <td><a class="faed-btn faed-btn--ghost faed-btn--sm" asp-action="Edit" asp-route-id="@item.Id">Manage</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model='PaginationViewModel.From(Model.Items, "Index", new Dictionary<string, string?> { ["filter"] = Model.Filter.ToString() }, "listing")' />
    }
</div>
