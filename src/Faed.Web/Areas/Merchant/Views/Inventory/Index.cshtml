@model InventoryPageModel
@{
    ViewData["Title"] = "Inventory";
}

<div class="faed-page faed-page--wide">
    <partial name="_MerchantSubnav" model="@("Inventory")" />

    <div class="faed-page__header">
        <div>
            <h1 class="faed-page__title">Inventory</h1>
            <p class="faed-page__subtitle">Stock across every variant, and a history of manual corrections.</p>
        </div>
    </div>

    <div class="faed-stat-row">
        <div class="faed-stat">
            <div class="faed-stat__value">@Model.Summary.ActiveVariantCount</div>
            <div class="faed-stat__label">Active variants</div>
        </div>
        <div class="faed-stat @(Model.Summary.LowStockVariantCount > 0 ? "faed-stat--attention" : "")">
            <div class="faed-stat__value">@Model.Summary.LowStockVariantCount</div>
            <div class="faed-stat__label">Low stock (&le; @InventorySummary.LowStockThreshold units)</div>
        </div>
        <div class="faed-stat">
            <div class="faed-stat__value">@Model.Summary.AvailableUnitsTotal</div>
            <div class="faed-stat__label">Available units</div>
        </div>
        <div class="faed-stat">
            <div class="faed-stat__value">@Model.Summary.ReservedUnitsTotal</div>
            <div class="faed-stat__label">Reserved units</div>
        </div>
    </div>

    @if (Model.Rows.TotalCount == 0)
    {
        <div class="faed-empty">
            <div class="faed-empty__title">No variants yet</div>
            <div>Add variants to a listing to start tracking stock.</div>
            <div class="faed-empty__actions">
                <a class="faed-btn faed-btn--ghost faed-btn--sm" asp-area="Merchant" asp-controller="Listings" asp-action="Index">Manage listings</a>
            </div>
        </div>
    }
    else
    {
        <div class="faed-table-wrap mb-4">
            <table class="faed-table">
                <thead>
                    <tr>
                        <th scope="col">SKU</th>
                        <th scope="col">Listing</th>
                        <th scope="col">Combination</th>
                        <th scope="col">Available</th>
                        <th scope="col">Reserved</th>
                        <th scope="col">Sold</th>
                        <th scope="col">Active</th>
                        <th scope="col">Adjust</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows.Items)
                    {
                        <tr class="@(row.IsActive && row.AvailableQuantity <= InventorySummary.LowStockThreshold ? "faed-row--attention" : "")">
                            <td><strong>@row.Sku</strong></td>
                            <td><a asp-area="Merchant" asp-controller="Listings" asp-action="Edit" asp-route-id="@row.ListingId">@row.ListingTitle</a></td>
                            <td>@row.Combination</td>
                            <td>@row.AvailableQuantity</td>
                            <td>@row.ReservedQuantity</td>
                            <td>@row.SoldQuantity</td>
                            <td>@(row.IsActive ? "Yes" : "No")</td>
                            <td>
                                <button type="button" class="faed-btn faed-btn--ghost faed-btn--sm"
                                        aria-label="Adjust stock for @row.Sku (@row.ListingTitle)"
                                        onclick="document.getElementById('adjust-@row.VariantId').showModal()">
                                    Adjust
                                </button>
                                <dialog id="adjust-@row.VariantId" class="faed-panel faed-dialog" aria-label="Adjust stock for @row.Sku">
                                    <form asp-action="Adjust" method="post">
                                        <input type="hidden" name="Adjust.VariantId" value="@row.VariantId" />
                                        <h2 class="faed-panel__title">Adjust @row.Sku</h2>
                                        <p class="faed-panel__hint">@row.ListingTitle &middot; @row.Combination &middot; currently @row.AvailableQuantity available</p>
                                        <div class="faed-field">
                                            <label class="faed-field__label" for="adjust-type-@row.VariantId">Reason type</label>
                                            <select class="faed-select" id="adjust-type-@row.VariantId" name="Adjust.AdjustmentType">
                                                <option value="@InventoryAdjustmentType.StockFound">Stock found (adds units)</option>
                                                <option value="@InventoryAdjustmentType.StockLostOrDamaged">Lost or damaged (removes units)</option>
                                                <option value="@InventoryAdjustmentType.ManualCorrection">Manual correction</option>
                                            </select>
                                        </div>
                                        <div class="faed-field">
                                            <label class="faed-field__label" for="adjust-qty-@row.VariantId">Quantity change</label>
                                            <input class="faed-input" id="adjust-qty-@row.VariantId" type="number"
                                                   name="Adjust.QuantityDelta" placeholder="e.g. 5 or -2"
                                                   aria-describedby="adjust-qty-hint-@row.VariantId" />
                                            <span class="faed-field__hint" id="adjust-qty-hint-@row.VariantId">Positive to add units, negative to remove them.</span>
                                        </div>
                                        <div class="faed-field">
                                            <label class="faed-field__label" for="adjust-reason-@row.VariantId">Reason</label>
                                            <textarea class="faed-input" id="adjust-reason-@row.VariantId" name="Adjust.Reason" rows="2"></textarea>
                                        </div>
                                        <button type="submit" class="faed-btn faed-btn--primary">Save adjustment</button>
                                        <button type="button" class="faed-btn faed-btn--ghost" onclick="document.getElementById('adjust-@row.VariantId').close()">Cancel</button>
                                    </form>
                                </dialog>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model='PaginationViewModel.From(Model.Rows, "Index", itemNoun: "variant")' />
    }

    <h2 class="faed-panel__title">Recent adjustments</h2>
    @if (Model.RecentAdjustments.Count == 0)
    {
        <div class="faed-empty">
            <div class="faed-empty__title">No adjustments yet</div>
        </div>
    }
    else
    {
        <div class="faed-table-wrap">
            <table class="faed-table">
                <thead>
                    <tr>
                        <th scope="col">When</th>
                        <th scope="col">Listing</th>
                        <th scope="col">SKU</th>
                        <th scope="col">Type</th>
                        <th scope="col">Change</th>
                        <th scope="col">Before &rarr; After</th>
                        <th scope="col">Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var adjustment in Model.RecentAdjustments)
                    {
                        <tr>
                            <td>@AmmanTime.FormatDateTime(adjustment.CreatedAtUtc)</td>
                            <td>@adjustment.ListingTitle</td>
                            <td>@adjustment.Sku</td>
                            <td>@ListingStatusDisplay.AdjustmentTypeLabel(adjustment.AdjustmentType)</td>
                            <td>@(adjustment.QuantityDelta > 0 ? $"+{adjustment.QuantityDelta}" : adjustment.QuantityDelta.ToString())</td>
                            <td>@adjustment.QuantityBefore &rarr; @adjustment.QuantityAfter</td>
                            <td>@adjustment.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
