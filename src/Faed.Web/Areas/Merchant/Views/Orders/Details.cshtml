@model MerchantOrderDetailPageModel
@{
    var order = Model.Order;
    ViewData["Title"] = $"Order #{order.Reference}";
    var firstItem = order.Items.Count > 0 ? order.Items[0].ListingTitle : "your item";
    var whatsApp = order.ContactRevealed
        ? WhatsAppLink.Build(order.ContactPhone, $"Hi, about your Faed reservation of {firstItem}. Order #{order.Reference}")
        : null;
    var steps = new (string Label, bool Reached)[]
    {
        ("Reserved", true),
        ("Confirmed", order.Status is OrderStatus.Confirmed or OrderStatus.ReadyForPickup or OrderStatus.OutForDelivery or OrderStatus.Completed),
        ("Ready", order.Status is OrderStatus.ReadyForPickup or OrderStatus.OutForDelivery or OrderStatus.Completed),
        ("Collected", order.Status == OrderStatus.Completed),
    };
}

<div class="faed-page faed-page--wide">
    <partial name="_MerchantSubnav" model="@("Orders")" />

    <nav class="faed-breadcrumb" aria-label="Breadcrumb">
        <a asp-action="Index">Orders</a>
        <span aria-hidden="true">/</span>
        <span>#@order.Reference</span>
    </nav>

    <div class="faed-page__header">
        <div>
            <h1 class="faed-page__title">Order #@order.Reference</h1>
            <p class="faed-page__subtitle">Reserved @AmmanTime.FormatDateTime(order.CreatedAtUtc) · pickup, cash on collection</p>
        </div>
        <div class="faed-page__actions">
            <span class="@OrderStatusDisplay.BadgeClass(order.Status)">@OrderStatusDisplay.Label(order.Status)</span>
        </div>
    </div>

    <ol class="faed-order-progress" aria-label="Order progress">
        @{ var stepNumber = 0; }
        @foreach (var step in steps)
        {
            stepNumber++;
            <li class="@(step.Reached ? "is-reached" : "")"><span>@stepNumber</span><strong>@step.Label</strong></li>
        }
    </ol>

    @if (order.Status == OrderStatus.Pending && order.ReservationExpiresAtUtc is { } expires)
    {
        <div class="faed-alert faed-alert--info" role="status">
            The item is held for this buyer until about @AmmanTime.FormatDateTime(expires). Confirm before then,
            or the reservation is cancelled automatically and the stock released.
        </div>
    }
    else if (order.Status == OrderStatus.Confirmed)
    {
        <div class="faed-alert faed-alert--info" role="status">
            Prepare this order for pickup within 48 hours of confirming, or it is recorded as a no-show and the stock released.
        </div>
    }
    else if (order.Status == OrderStatus.ReadyForPickup)
    {
        <div class="faed-alert faed-alert--info" role="status">
            If the buyer does not collect within 72 hours, this order is closed as a no-show and the stock released.
        </div>
    }
    @if (!string.IsNullOrEmpty(order.StatusReason) && order.Status is OrderStatus.Cancelled or OrderStatus.NoShow)
    {
        <div class="faed-alert faed-alert--error" role="status">@order.StatusReason</div>
    }

    <div class="faed-panel">
        <h2 class="faed-panel__title">Items</h2>
        <div class="faed-table-wrap">
            <table class="faed-table">
                <thead>
                    <tr>
                        <th scope="col">Item</th>
                        <th scope="col">Condition</th>
                        <th scope="col">Unit price</th>
                        <th scope="col">Qty</th>
                        <th scope="col">Line total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in order.Items)
                    {
                        <tr>
                            <td>@item.ListingTitle<div class="faed-field__hint">@item.VariantSnapshot</div></td>
                            <td>@item.ConditionSnapshot</td>
                            <td>JOD @item.UnitPrice.ToString("0.000")</td>
                            <td>@item.Quantity</td>
                            <td>JOD @item.LineTotal.ToString("0.000")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><th scope="row" colspan="4">Subtotal</th><td>JOD @order.Subtotal.ToString("0.000")</td></tr>
                    <tr><th scope="row" colspan="4">Total</th><td><strong>JOD @order.Total.ToString("0.000")</strong></td></tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="faed-panel">
        <h2 class="faed-panel__title">Buyer &amp; pickup</h2>
        <dl class="faed-details">
            <dt>Buyer</dt>
            <dd>@order.ContactName</dd>
            <dt>Phone</dt>
            <dd>
                @if (order.ContactRevealed)
                {
                    @order.ContactPhone
                }
                else
                {
                    <span class="faed-field__hint">Revealed once you confirm the order.</span>
                }
            </dd>
            <dt>Pickup point</dt>
            <dd>@order.FulfillmentSnapshot</dd>
            @if (!string.IsNullOrWhiteSpace(order.BuyerNote))
            {
                <dt>Buyer note</dt>
                <dd>@order.BuyerNote</dd>
            }
        </dl>
        @if (whatsApp is not null)
        {
            <a class="faed-btn faed-btn--ghost faed-whatsapp-btn" href="@whatsApp" target="_blank" rel="noopener">
                @FaedIcon.Render("chat", "faed-icon") Message the buyer on WhatsApp
            </a>
        }
    </div>

    @if (order.MerchantCanConfirm || order.MerchantCanMarkReadyForPickup || order.MerchantCanMarkOutForDelivery
        || order.MerchantCanComplete || order.MerchantCanMarkNoShow || order.MerchantCanCancel
        || order.MerchantCanRecordLateCollection)
    {
        <div class="faed-panel">
            <h2 class="faed-panel__title">Update this order</h2>
            <div class="faed-page__actions">
                @if (order.MerchantCanConfirm)
                {
                    <form asp-action="Confirm" asp-route-id="@order.Id" method="post">
                        <button type="submit" class="faed-btn faed-btn--primary">Confirm order</button>
                    </form>
                }
                @if (order.MerchantCanMarkReadyForPickup)
                {
                    <form asp-action="ReadyForPickup" asp-route-id="@order.Id" method="post">
                        <button type="submit" class="faed-btn faed-btn--primary">Mark ready for pickup</button>
                    </form>
                }
                @if (order.MerchantCanMarkOutForDelivery)
                {
                    <form asp-action="OutForDelivery" asp-route-id="@order.Id" method="post">
                        <button type="submit" class="faed-btn faed-btn--primary">Mark out for delivery</button>
                    </form>
                }
                @if (order.MerchantCanComplete)
                {
                    <form asp-action="Complete" asp-route-id="@order.Id" method="post">
                        <button type="submit" class="faed-btn faed-btn--primary">Mark completed</button>
                    </form>
                }
            </div>

            @if (order.MerchantCanRecordLateCollection)
            {
                <p class="faed-field__hint faed-action-spaced">
                    This order was closed as a no-show. If the buyer did collect and pay, record it here —
                    the stock is booked as sold and the buyer can leave a review.
                </p>
                <form asp-action="ActuallyCollected" asp-route-id="@order.Id" method="post">
                    <button type="submit" class="faed-btn faed-btn--primary">The buyer actually collected this</button>
                </form>
            }

            @if (order.MerchantCanMarkNoShow)
            {
                <form asp-action="NoShow" asp-route-id="@order.Id" method="post" class="faed-field faed-field--spaced">
                    <label class="faed-field__label" for="noshow-reason">No-show reason</label>
                    <input class="faed-input" id="noshow-reason" name="reason" maxlength="500" required />
                    <button type="submit" class="faed-btn faed-btn--ghost faed-action-spaced">Mark as no-show</button>
                </form>
            }

            @if (order.MerchantCanCancel)
            {
                <form asp-action="Cancel" asp-route-id="@order.Id" method="post" class="faed-field faed-field--spaced">
                    <label class="faed-field__label" for="cancel-reason">Cancellation reason</label>
                    <input class="faed-input" id="cancel-reason" name="reason" maxlength="500" required />
                    <button type="submit" class="faed-btn faed-btn--danger faed-action-spaced">Cancel order</button>
                </form>
            }
        </div>
    }

</div>
