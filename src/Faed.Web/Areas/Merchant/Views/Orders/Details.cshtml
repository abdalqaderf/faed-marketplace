@model MerchantOrderDetailPageModel
@{
    var order = Model.Order;
    ViewData["Title"] = $"Order — {order.ContactName}";
}

<div class="faed-page faed-page--wide">
    <partial name="_MerchantSubnav" model="@("Orders")" />

    <nav class="faed-breadcrumb" aria-label="Breadcrumb">
        <a asp-action="Index">B2C orders</a>
        <span aria-hidden="true">/</span>
        <span>@AmmanTime.FormatDateTime(order.CreatedAtUtc)</span>
    </nav>

    <div class="faed-page__header">
        <div>
            <h1 class="faed-page__title">Order @order.Id.ToString()[..8]</h1>
            <p class="faed-page__subtitle">
                Placed @AmmanTime.FormatDateTime(order.CreatedAtUtc) ·
                @OrderStatusDisplay.FulfillmentLabel(order.FulfillmentType)
            </p>
        </div>
        <div class="faed-page__actions">
            <span class="@OrderStatusDisplay.BadgeClass(order.Status)">@OrderStatusDisplay.Label(order.Status)</span>
        </div>
    </div>

    @if (order.Status == OrderStatus.Pending && order.ReservationExpiresAtUtc is { } expires)
    {
        <div class="faed-alert faed-alert--info" role="status">
            Stock is reserved for this order until about @AmmanTime.FormatDateTime(expires). Confirm it before then,
            or it is cancelled automatically and the stock is released.
        </div>
    }
    @if (!string.IsNullOrEmpty(order.StatusReason) && order.Status is OrderStatus.Cancelled or OrderStatus.NoShow)
    {
        <div class="faed-alert faed-alert--error" role="status">@order.StatusReason</div>
    }

    <div class="faed-panel">
        <h2 class="faed-panel__title">Items</h2>
        <div class="faed-table-wrap">
            <table class="faed-table">
                <thead>
                    <tr>
                        <th scope="col">Item</th>
                        <th scope="col">Condition</th>
                        <th scope="col">Unit price</th>
                        <th scope="col">Qty</th>
                        <th scope="col">Line total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in order.Items)
                    {
                        <tr>
                            <td>@item.ListingTitle<div class="faed-field__hint">@item.VariantSnapshot</div></td>
                            <td>@item.ConditionSnapshot</td>
                            <td>JOD @item.UnitPrice.ToString("0.000")</td>
                            <td>@item.Quantity</td>
                            <td>JOD @item.LineTotal.ToString("0.000")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><th scope="row" colspan="4">Subtotal</th><td>JOD @order.Subtotal.ToString("0.000")</td></tr>
                    <tr><th scope="row" colspan="4">Fulfilment fee</th><td>JOD @order.DeliveryFeeSnapshot.ToString("0.000")</td></tr>
                    <tr><th scope="row" colspan="4">Total</th><td><strong>JOD @order.Total.ToString("0.000")</strong></td></tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="faed-panel">
        <h2 class="faed-panel__title">Buyer &amp; fulfilment</h2>
        <dl class="faed-details">
            <dt>Contact</dt>
            <dd>@order.ContactName · @order.ContactPhone</dd>
            <dt>Method</dt>
            <dd>@OrderStatusDisplay.FulfillmentLabel(order.FulfillmentType)</dd>
            <dt>Details</dt>
            <dd>@order.FulfillmentSnapshot</dd>
            @if (!string.IsNullOrWhiteSpace(order.DeliveryAddressText))
            {
                <dt>Delivery address</dt>
                <dd>@order.DeliveryAddressText</dd>
            }
            @if (!string.IsNullOrWhiteSpace(order.BuyerNote))
            {
                <dt>Buyer note</dt>
                <dd>@order.BuyerNote</dd>
            }
        </dl>
    </div>

    @if (order.MerchantCanConfirm || order.MerchantCanMarkReadyForPickup || order.MerchantCanMarkOutForDelivery
        || order.MerchantCanComplete || order.MerchantCanMarkNoShow || order.MerchantCanCancel)
    {
        <div class="faed-panel">
            <h2 class="faed-panel__title">Update this order</h2>
            <div class="faed-page__actions">
                @if (order.MerchantCanConfirm)
                {
                    <form asp-action="Confirm" asp-route-id="@order.Id" method="post">
                        <button type="submit" class="faed-btn faed-btn--primary">Confirm order</button>
                    </form>
                }
                @if (order.MerchantCanMarkReadyForPickup)
                {
                    <form asp-action="ReadyForPickup" asp-route-id="@order.Id" method="post">
                        <button type="submit" class="faed-btn faed-btn--primary">Mark ready for pickup</button>
                    </form>
                }
                @if (order.MerchantCanMarkOutForDelivery)
                {
                    <form asp-action="OutForDelivery" asp-route-id="@order.Id" method="post">
                        <button type="submit" class="faed-btn faed-btn--primary">Mark out for delivery</button>
                    </form>
                }
                @if (order.MerchantCanComplete)
                {
                    <form asp-action="Complete" asp-route-id="@order.Id" method="post">
                        <button type="submit" class="faed-btn faed-btn--primary">Mark completed</button>
                    </form>
                }
            </div>

            @if (order.MerchantCanMarkNoShow)
            {
                <form asp-action="NoShow" asp-route-id="@order.Id" method="post" class="faed-field" style="margin-top:1rem;">
                    <label class="faed-field__label" for="noshow-reason">No-show reason</label>
                    <input class="faed-input" id="noshow-reason" name="reason" maxlength="500" required />
                    <button type="submit" class="faed-btn faed-btn--ghost" style="margin-top:0.5rem;">Mark as no-show</button>
                </form>
            }

            @if (order.MerchantCanCancel)
            {
                <form asp-action="Cancel" asp-route-id="@order.Id" method="post" class="faed-field" style="margin-top:1rem;">
                    <label class="faed-field__label" for="cancel-reason">Cancellation reason</label>
                    <input class="faed-input" id="cancel-reason" name="reason" maxlength="500" required />
                    <button type="submit" class="faed-btn faed-btn--danger" style="margin-top:0.5rem;">Cancel order</button>
                </form>
            }
        </div>
    }

    @if (Model.ActiveDispute is not null || Model.PastDisputes.Count > 0 || Model.CanRaiseDispute)
    {
        <div class="faed-panel">
            <h2 class="faed-panel__title">Disputes</h2>
            @if (Model.ActiveDispute is { } active)
            {
                <p class="faed-panel__hint">
                    <span class="@DisputeStatusDisplay.BadgeClass(active.Status)">@DisputeStatusDisplay.Label(active.Status)</span>
                    &nbsp;@DisputeStatusDisplay.ReasonLabel(active.ReasonCode) · raised @AmmanTime.FormatDate(active.CreatedAtUtc)
                </p>
                <a class="faed-btn faed-btn--ghost" asp-controller="Disputes" asp-action="Details" asp-route-id="@active.Id">
                    View dispute
                </a>
            }
            @if (Model.PastDisputes.Count > 0)
            {
                <ul class="faed-field__hint">
                    @foreach (var past in Model.PastDisputes)
                    {
                        <li>
                            <a asp-controller="Disputes" asp-action="Details" asp-route-id="@past.Id">
                                @DisputeStatusDisplay.ReasonLabel(past.ReasonCode)
                            </a>
                            — @DisputeStatusDisplay.Label(past.Status), @AmmanTime.FormatDate(past.CreatedAtUtc)
                        </li>
                    }
                </ul>
            }
            @if (Model.CanRaiseDispute)
            {
                <p class="faed-panel__hint">
                    If the buyer did not collect the order, damaged returned goods, or there is another problem
                    with this transaction, you can raise a dispute for an administrator to review.
                </p>
                <a class="faed-btn faed-btn--ghost" asp-controller="Disputes" asp-action="Create"
                   asp-route-type="@TrustTransactionType.B2COrder" asp-route-id="@order.Id">
                    Raise a dispute
                </a>
            }
        </div>
    }
</div>
