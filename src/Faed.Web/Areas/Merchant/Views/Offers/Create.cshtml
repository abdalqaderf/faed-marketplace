@model B2BOfferCreatePageModel
@{
    ViewData["Title"] = $"Make an offer — {Model.Listing.Title}";
    var listing = Model.Listing;
    var moqNote = listing.AllowMixedVariantLots
        ? $"Minimum {listing.MinimumOrderQuantity} units total, mixed variants allowed."
        : $"Minimum {listing.MinimumOrderQuantity} units per variant.";
}

<div class="faed-page">
    <partial name="_MerchantSubnav" model="@("Offers")" />

    <nav class="faed-breadcrumb" aria-label="Breadcrumb">
        <a asp-action="Index">B2B offers</a>
        <span aria-hidden="true">/</span>
        <span>New offer</span>
    </nav>

    <div class="faed-page__header">
        <div>
            <h1 class="faed-page__title">Make a wholesale offer</h1>
            <p class="faed-page__subtitle">
                @listing.Title · sold by @listing.SellingMerchantName
            </p>
        </div>
    </div>

    <div asp-validation-summary="All" class="faed-alert faed-alert--error" role="alert"></div>

    <div class="faed-panel faed-merchant-form-panel">
        <p class="faed-panel__hint">
            @moqNote
            @if (listing.IndicativeUnitPrice is { } indicative)
            {
                <text> Indicative unit price JOD @indicative.ToString("0.000").</text>
            }
        </p>

        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="Form.ListingSlug" />

            <div class="faed-merchant-form-section__heading">
                <strong>Requested stock</strong>
                <span>Select the quantity you want from each available variant.</span>
            </div>

            <fieldset class="faed-field faed-fieldset-reset">
                <legend class="faed-field__label">Quantities by variant</legend>
                <div class="faed-table-wrap">
                    <table class="faed-table">
                        <thead>
                            <tr>
                                <th scope="col">Variant</th>
                                <th scope="col">In stock</th>
                                <th scope="col">Offer quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Form.Lines.Count; i++)
                            {
                                <tr>
                                    <td>
                                        @Model.Form.Lines[i].Combination
                                        <input type="hidden" asp-for="Form.Lines[i].VariantId" />
                                        <input type="hidden" asp-for="Form.Lines[i].Combination" />
                                    </td>
                                    <td>@Model.Form.Lines[i].AvailableQuantity</td>
                                    <td>
                                        <input class="faed-input" type="number" min="0" step="1"
                                               asp-for="Form.Lines[i].Quantity"
                                               aria-label="Offer quantity for @Model.Form.Lines[i].Combination" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="faed-field__hint">
                    A wholesale offer is not a stock reservation — the stock is only held when the deal is accepted and confirmed.
                </p>
            </fieldset>

            <div class="faed-merchant-form-section__heading">
                <strong>Commercial terms</strong>
                <span>Set the proposed unit price, validity period, and optional message.</span>
            </div>

            <div class="faed-merchant-form-grid">
                <div class="faed-field">
                    <label class="faed-field__label" asp-for="Form.ProposedUnitPrice"></label>
                    <input class="faed-input" type="number" step="0.001" min="0.001" asp-for="Form.ProposedUnitPrice" />
                    <span asp-validation-for="Form.ProposedUnitPrice" class="faed-field__error"></span>
                </div>

                <div class="faed-field">
                    <label class="faed-field__label" asp-for="Form.ValidityDays"></label>
                    <input class="faed-input" type="number" min="1" max="30" step="1" asp-for="Form.ValidityDays" />
                    <span asp-validation-for="Form.ValidityDays" class="faed-field__error"></span>
                </div>

                <div class="faed-field faed-field--full">
                    <label class="faed-field__label" asp-for="Form.Message"></label>
                    <textarea class="faed-input" rows="3" asp-for="Form.Message" placeholder="Add context for the seller (optional)."></textarea>
                    <span asp-validation-for="Form.Message" class="faed-field__error"></span>
                </div>
            </div>

            <div class="faed-merchant-form-actions">
                <button type="submit" class="faed-btn faed-btn--primary">Send offer</button>
                <a class="faed-btn faed-btn--ghost" asp-controller="Listing" asp-action="Details" asp-area="" asp-route-slug="@listing.Slug">@FaedIcon.Render("arrow-left", "faed-icon")<span>Back to listing</span></a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
