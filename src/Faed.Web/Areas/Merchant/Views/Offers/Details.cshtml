@model B2BNegotiationDetailPageModel
@{
    var n = Model.Negotiation;
    ViewData["Title"] = $"Negotiation — {n.ListingTitle}";
    var current = n.CurrentRevision;
    var moqNote = n.AllowMixedVariantLots
        ? $"Minimum {n.MinimumOrderQuantity} units total, mixed variants allowed."
        : $"Minimum {n.MinimumOrderQuantity} units per variant.";
    var showCounter = n.CanRespond;
}

<div class="faed-page faed-page--wide">
    <partial name="_MerchantSubnav" model="@("Offers")" />

    <nav class="faed-breadcrumb" aria-label="Breadcrumb">
        <a asp-action="Index">B2B offers</a>
        <span aria-hidden="true">/</span>
        <span>@n.ListingTitle</span>
    </nav>

    <div class="faed-page__header">
        <div>
            <h1 class="faed-page__title">Wholesale negotiation</h1>
            <p class="faed-page__subtitle">
                <a asp-controller="Listing" asp-action="Details" asp-area="" asp-route-slug="@n.ListingSlug">@n.ListingTitle</a> ·
                you are the @B2BNegotiationStatusDisplay.PartyLabel(n.MyRole).ToLower() ·
                other merchant: @n.CounterpartyName
            </p>
        </div>
        <div class="faed-page__actions">
            <span class="@B2BNegotiationStatusDisplay.BadgeClass(n.Status)">@B2BNegotiationStatusDisplay.Label(n.Status)</span>
        </div>
    </div>

    @if (n.Status == B2BNegotiationStatus.Open && n.CurrentOfferHasExpired)
    {
        <div class="faed-alert faed-alert--error" role="status">
            The current offer expired on @AmmanTime.FormatDateTime(current.OfferExpiresAtUtc) and can no longer be accepted.
            It will be closed automatically.
        </div>
    }
    else if (n.Status == B2BNegotiationStatus.Open && n.AwaitingMyResponse)
    {
        <div class="faed-alert faed-alert--info" role="status">
            It is your turn to respond. This offer is valid until @AmmanTime.FormatDateTime(current.OfferExpiresAtUtc).
        </div>
    }
    else if (n.Status == B2BNegotiationStatus.Open)
    {
        <div class="faed-alert faed-alert--info" role="status">
            Waiting for @n.CounterpartyName to respond. Offer valid until @AmmanTime.FormatDateTime(current.OfferExpiresAtUtc).
        </div>
    }
    else if (n.Status == B2BNegotiationStatus.Accepted)
    {
        <div class="faed-alert faed-alert--success" role="status">
            Both merchants agreed on revision @current.RevisionNumber and the stock is reserved.
            @if (n.DealId is { } dealId)
            {
                <a asp-controller="Deals" asp-action="Details" asp-route-id="@dealId">Open the wholesale deal</a>
                <text> to arrange fulfilment.</text>
            }
        </div>
    }

    <div class="faed-panel">
        <h2 class="faed-panel__title">Offer history</h2>
        <p class="faed-panel__hint">@moqNote Every counter-offer is kept in full — nothing here is overwritten.</p>

        @foreach (var revision in n.Revisions.Reverse())
        {
            var isCurrent = revision.RevisionNumber == current.RevisionNumber;
            <article class="faed-panel faed-field--spaced">
                <h3 class="faed-panel__title faed-panel__title--sm">
                    Revision @revision.RevisionNumber — proposed by @B2BNegotiationStatusDisplay.PartyLabel(revision.ProposedBy).ToLower() (@revision.ProposedByName)
                    @if (isCurrent && n.Status == B2BNegotiationStatus.Open)
                    {
                        <span class="faed-badge faed-badge--info">Current offer</span>
                    }
                </h3>
                <dl class="faed-details">
                    <dt>Unit price</dt>
                    <dd>JOD @revision.UnitPrice.ToString("0.000")</dd>
                    <dt>Total quantity</dt>
                    <dd>@revision.TotalQuantity units</dd>
                    <dt>Offer total</dt>
                    <dd>JOD @revision.Total.ToString("0.000")</dd>
                    <dt>Valid until</dt>
                    <dd>@AmmanTime.FormatDateTime(revision.OfferExpiresAtUtc)</dd>
                    <dt>Proposed</dt>
                    <dd>@AmmanTime.FormatDateTime(revision.CreatedAtUtc)</dd>
                    @if (!string.IsNullOrWhiteSpace(revision.Message))
                    {
                        <dt>Message</dt>
                        <dd>@revision.Message</dd>
                    }
                </dl>
                <div class="faed-table-wrap">
                    <table class="faed-table">
                        <thead><tr><th scope="col">Variant</th><th scope="col">Quantity</th></tr></thead>
                        <tbody>
                            @foreach (var line in revision.Lines)
                            {
                                <tr><td>@line.VariantCombination</td><td>@line.Quantity</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </article>
        }
    </div>

    @if (n.CanRespond)
    {
        <div class="faed-panel">
            <h2 class="faed-panel__title">Respond to revision @current.RevisionNumber</h2>
            <p class="faed-panel__hint">
                Accepting reserves @current.TotalQuantity units for the wholesale deal
                (JOD @current.Total.ToString("0.000") for the goods). The reservation is separate from the offer's expiry.
            </p>
            <form asp-action="Accept" asp-route-id="@n.Id" method="post">
                <fieldset class="faed-field faed-fieldset-reset">
                    <legend class="faed-field__label">How will this deal be fulfilled?</legend>
                    <label class="faed-checkbox-row">
                        <input type="radio" name="fulfillmentType" value="@B2BFulfillmentType.Pickup" checked />
                        <span>Direct pickup — the buying merchant collects the lot</span>
                    </label>
                    <label class="faed-checkbox-row">
                        <input type="radio" name="fulfillmentType" value="@B2BFulfillmentType.SellerArrangedShipping" />
                        <span>Seller-arranged shipping — the seller arranges a carrier and records a reference later</span>
                    </label>
                </fieldset>
                <p class="faed-field__hint">
                    The deal total is JOD @current.Total.ToString("0.000") — the agreed unit price and quantities.
                    Any shipping arrangements are handled by the selling merchant once the deal is reserved.
                </p>
                <div class="faed-page__actions">
                    <button type="submit" class="faed-btn faed-btn--primary">Accept &amp; reserve the deal</button>
                </div>
            </form>
            <form asp-action="Reject" asp-route-id="@n.Id" method="post" class="faed-field--spaced">
                <button type="submit" class="faed-btn faed-btn--danger">Reject</button>
            </form>
        </div>
    }

    @if (showCounter)
    {
        <div class="faed-panel">
            <h2 class="faed-panel__title">Counter-offer</h2>
            <p class="faed-panel__hint">A counter-offer is a new revision. The previous offer stays on record.</p>
            <div asp-validation-summary="All" class="faed-alert faed-alert--error" role="alert"></div>
            <form asp-action="Counter" asp-route-id="@n.Id" method="post">
                <fieldset class="faed-field faed-fieldset-reset">
                    <legend class="faed-field__label">Quantities by variant</legend>
                    <div class="faed-table-wrap">
                        <table class="faed-table">
                            <thead><tr><th scope="col">Variant</th><th scope="col">In stock</th><th scope="col">Quantity</th></tr></thead>
                            <tbody>
                                @for (var i = 0; i < Model.CounterForm.Lines.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            @Model.CounterForm.Lines[i].Combination
                                            <input type="hidden" name="Lines[@i].VariantId" value="@Model.CounterForm.Lines[i].VariantId" />
                                        </td>
                                        <td>@Model.CounterForm.Lines[i].AvailableQuantity</td>
                                        <td>
                                            <input class="faed-input" type="number" min="0" step="1"
                                                   name="Lines[@i].Quantity" value="@Model.CounterForm.Lines[i].Quantity"
                                                   aria-label="Counter-offer quantity for @Model.CounterForm.Lines[i].Combination" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </fieldset>
                <div class="faed-field">
                    <label class="faed-field__label" for="counter-price">Proposed unit price (JOD)</label>
                    <input class="faed-input" id="counter-price" name="ProposedUnitPrice" type="number" step="0.001" min="0.001"
                           value="@Model.CounterForm.ProposedUnitPrice.ToString("0.000")" />
                </div>
                <div class="faed-field">
                    <label class="faed-field__label" for="counter-validity">Offer valid for (days)</label>
                    <input class="faed-input" id="counter-validity" name="ValidityDays" type="number" min="1" max="30" step="1"
                           value="@Model.CounterForm.ValidityDays" />
                </div>
                <div class="faed-field">
                    <label class="faed-field__label" for="counter-message">Message (optional)</label>
                    <textarea class="faed-input" id="counter-message" name="Message" rows="3" maxlength="2000"></textarea>
                </div>
                <button type="submit" class="faed-btn faed-btn--primary">Send counter-offer</button>
            </form>
        </div>
    }

    @if (n.CanCancel)
    {
        <div class="faed-panel">
            <h2 class="faed-panel__title">Withdraw</h2>
            <p class="faed-panel__hint">Cancelling closes the negotiation for both merchants. It cannot be reopened.</p>
            <form asp-action="Cancel" asp-route-id="@n.Id" method="post">
                <button type="submit" class="faed-btn faed-btn--ghost">Cancel negotiation</button>
            </form>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
