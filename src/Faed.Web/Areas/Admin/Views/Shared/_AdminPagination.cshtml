@model AdminPaginationPageModel

@if (Model.TotalPages > 1)
{
    <nav class="faed-pagination" aria-label="Pagination">
        @if (Model.Page > 1)
        {
            <a class="faed-btn faed-btn--ghost faed-btn--sm"
               asp-action="@Model.Action"
               asp-route-filter="@Model.Filter"
               asp-route-page="@(Model.Page - 1)">Previous</a>
        }
        <span class="faed-pagination__status">Page @Model.Page of @Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages)
        {
            <a class="faed-btn faed-btn--ghost faed-btn--sm"
               asp-action="@Model.Action"
               asp-route-filter="@Model.Filter"
               asp-route-page="@(Model.Page + 1)">Next</a>
        }
    </nav>
}

<p class="faed-section__hint">
    Showing @Model.FirstItemNumber&ndash;@Model.LastItemNumber of @Model.TotalCount matching record@(Model.TotalCount == 1 ? "" : "s").
</p>
