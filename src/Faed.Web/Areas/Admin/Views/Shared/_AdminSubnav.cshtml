@model string
@{
    var active = Model ?? string.Empty;
    (string Section, string Controller, string Action, string Label)[] links =
    {
        ("Overview", "Home", "Index", "Overview"),
        ("MerchantVerification", "MerchantVerification", "Index", "Merchant verification"),
        ("ListingModeration", "ListingModeration", "Index", "Listing moderation"),
        ("Orders", "Transactions", "Orders", "Orders"),
        ("Deals", "Transactions", "Deals", "B2B deals"),
        ("Disputes", "Disputes", "Index", "Disputes"),
        ("Catalog", "Catalog", "Index", "Catalog"),
        ("Reviews", "Reviews", "Index", "Reviews"),
        ("AuditLog", "AuditLog", "Index", "Audit log"),
    };
}
<div class="faed-workspace-nav faed-workspace-nav--admin">
    <div class="faed-workspace-nav__identity">
        <span class="faed-workspace-nav__eyebrow">Operations</span>
        <strong>Admin Workspace</strong>
    </div>
    <nav class="faed-subnav faed-subnav--workspace" aria-label="Admin sections">
        @foreach (var link in links)
        {
            <a class="@(active == link.Section ? "is-active" : "")" aria-current="@(active == link.Section ? "page" : null)"
               asp-area="Admin" asp-controller="@link.Controller" asp-action="@link.Action">@link.Label</a>
        }
    </nav>
</div>
