@page
@model RegisterModel
@{
    ViewData["Title"] = "Create account";
}

@* Conventional label-above-input rather than Bootstrap .form-floating. Floating labels
   repeat their own text as the input placeholder, and Bootstrap only hides that placeholder
   while the field is unfocused — so the label and an identical placeholder were both visible
   the moment a field was focused. Real labels remove the duplication outright. *@
<div class="faed-auth-form-shell">
    <header class="faed-auth-form-header">
        <h1>@ViewData["Title"]</h1>
        <p class="faed-auth-lead">
            Create your Faed account to shop the marketplace. If you want to sell later,
            merchant access is added after verification.
        </p>
    </header>

    <form id="registerForm" class="faed-auth-form" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        <div asp-validation-summary="ModelOnly" class="faed-auth-validation-summary" role="alert"></div>

        <div class="faed-form-grid">
            <div class="faed-field">
                <label class="faed-field__label" asp-for="Input.FirstName">
                    First name <span class="faed-field__required" aria-hidden="true">*</span>
                </label>
                <input class="faed-input" asp-for="Input.FirstName" autocomplete="given-name"
                       aria-required="true" />
                <span class="faed-field__error" asp-validation-for="Input.FirstName"></span>
            </div>

            <div class="faed-field">
                <label class="faed-field__label" asp-for="Input.LastName">
                    Last name <span class="faed-field__required" aria-hidden="true">*</span>
                </label>
                <input class="faed-input" asp-for="Input.LastName" autocomplete="family-name"
                       aria-required="true" />
                <span class="faed-field__error" asp-validation-for="Input.LastName"></span>
            </div>

            <div class="faed-field faed-field--full">
                <label class="faed-field__label" asp-for="Input.PhoneNumber">
                    Phone number <span class="faed-field__required" aria-hidden="true">*</span>
                </label>
                <input class="faed-input" asp-for="Input.PhoneNumber" autocomplete="tel" inputmode="tel"
                       aria-required="true" aria-describedby="register-phone-help" />
                <span class="faed-field__hint" id="register-phone-help">
                    Include the country code, for example +962 7X XXX XXXX.
                </span>
                <span class="faed-field__error" asp-validation-for="Input.PhoneNumber"></span>
            </div>

            <div class="faed-field faed-field--full">
                <label class="faed-field__label" asp-for="Input.Email">
                    Email <span class="faed-field__required" aria-hidden="true">*</span>
                </label>
                <input class="faed-input" asp-for="Input.Email" autocomplete="email" inputmode="email"
                       aria-required="true" aria-describedby="register-email-help" />
                <span class="faed-field__hint" id="register-email-help">
                    Use an address you can open — account confirmation is sent there.
                </span>
                <span class="faed-field__error" asp-validation-for="Input.Email"></span>
            </div>

            <div class="faed-field faed-field--full">
                <label class="faed-field__label" asp-for="Input.Password">
                    Password <span class="faed-field__required" aria-hidden="true">*</span>
                </label>
                <input class="faed-input" asp-for="Input.Password" autocomplete="new-password"
                       aria-required="true" aria-describedby="register-password-help" />
                <span class="faed-field__hint" id="register-password-help">
                    At least 6 characters, with an uppercase letter, a lowercase letter, a
                    number and a symbol.
                </span>
                <span class="faed-field__error" asp-validation-for="Input.Password"></span>
            </div>

            <div class="faed-field faed-field--full">
                <label class="faed-field__label" asp-for="Input.ConfirmPassword">
                    Confirm password <span class="faed-field__required" aria-hidden="true">*</span>
                </label>
                <input class="faed-input" asp-for="Input.ConfirmPassword" autocomplete="new-password"
                       aria-required="true" />
                <span class="faed-field__error" asp-validation-for="Input.ConfirmPassword"></span>
            </div>
        </div>

        <button id="registerSubmit" type="submit" class="faed-btn faed-btn--primary faed-auth-form__submit">
            Create account
        </button>

        <p class="faed-auth-switch">
            Already have an account?
            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
        </p>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
