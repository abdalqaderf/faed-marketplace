@page
@model Faed.Web.Areas.Identity.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

@* Reached whenever a signed-in user fails a server-side authorization policy — e.g. an
   administrator hitting a Buyer/Merchant-only route by direct URL, or a merchant applicant
   who is not yet approved reaching an approved-only screen. The link that got them here is
   already hidden from navigation where possible; this page is the recovery for the
   direct-URL case. It provides recovery without information leakage: no detail about the
   denied resource is shown, only that access was denied . *@
<div class="faed-page">
    <div class="faed-empty faed-error-state">
        <span class="faed-error-state__code">403</span>
        <h1 class="faed-empty__title">Access denied</h1>
        <p>Your account does not have permission to view that page.</p>
        <div class="faed-page__actions faed-page__actions--center">
            <a class="faed-btn faed-btn--primary" href="/">Back to Faed</a>
        </div>
    </div>
</div>
