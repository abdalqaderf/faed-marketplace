@model StorePageModel
@{
    ViewData["Title"] = Model.Merchant.BusinessName;
}

<div class="faed-page faed-page--wide">
    <div class="faed-store-header">
        <div class="faed-store-header__monogram" aria-hidden="true">@Model.Merchant.BusinessName.Substring(0, 1).ToUpperInvariant()</div>
        <div class="faed-store-header__identity">
            <p class="faed-kicker">Merchant storefront</p>
            <h1 class="faed-store-header__name">
                @Model.Merchant.BusinessName
                @if (Model.Merchant.IsVerified)
                {
                    <span class="faed-badge faed-badge--approved">
                        <span aria-hidden="true">&#10003;</span> Verified merchant
                    </span>
                }
            </h1>
            <p class="faed-store-header__meta">
                Member since @AmmanTime.FormatDate(Model.Merchant.MemberSinceUtc)
                &middot; @Model.Merchant.LiveListingCount active @(Model.Merchant.LiveListingCount == 1 ? "listing" : "listings")
            </p>
            <p class="faed-store-header__assurance">Business identity reviewed by Faed before selling access was granted.</p>
        </div>
    </div>

    @if (Model.Reviews is { Summary.HasReviews: true })
    {
        <section class="faed-panel" aria-label="Merchant reviews">
            <h2 class="faed-panel__title">
                Buyer reviews —
                <span aria-hidden="true">@DisputeStatusDisplay.Stars((int)Math.Round(Model.Reviews.Summary.AverageRating))</span>
                @Model.Reviews.Summary.AverageRating.ToString("0.0") / 5
                (@Model.Reviews.Summary.ReviewCount)
            </h2>
            <ul class="faed-review-list">
                @foreach (var review in Model.Reviews.Reviews)
                {
                    <li>
                        <span aria-hidden="true">@DisputeStatusDisplay.Stars(review.Rating)</span>
                        <strong>@review.Rating / 5</strong>
                        <span class="faed-field__hint">@review.ReviewerLabel · @AmmanTime.FormatDate(review.CreatedAtUtc)</span>
                        @if (!string.IsNullOrWhiteSpace(review.Comment))
                        {
                            <p class="faed-review-comment">@review.Comment</p>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    @if (Model.Merchant.LiveListingCount == 0)
    {
        <div class="faed-empty">
            <div class="faed-empty__title">This merchant has no active listings right now</div>
            <p>Check back soon, or continue browsing the marketplace.</p>
            <a class="faed-btn faed-btn--ghost" asp-controller="Shop" asp-action="Index">Continue shopping</a>
        </div>
    }
    else
    {
        <partial name="_ShopBrowse" model="Model" />
    }
</div>
