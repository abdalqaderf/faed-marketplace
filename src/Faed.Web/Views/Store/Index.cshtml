@model StorePageModel
@{
    ViewData["Title"] = Model.Merchant.BusinessName;

    var name = Model.Merchant.BusinessName;
    var initials = string.Concat(name
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(w => char.ToUpperInvariant(w[0])));
    if (initials.Length == 0)
    {
        initials = "F";
    }

    var response = Model.Merchant.Response;
    var isNewSeller = MerchantResponseDisplay.IsNewSeller(response);
    var since = AmmanTime.ToLocal(Model.Merchant.MemberSinceUtc)
        .ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture);
}

<div class="fx-wrap fx-main">

    <div class="fx-store-head">
        <div class="fx-store-head__identity">
            <span class="fx-avatar fx-avatar--lg" aria-hidden="true">@initials</span>
            <div>
                <div class="fx-store-head__name-row">
                    <h1 class="fx-store-head__name">@name</h1>
                    @if (Model.Merchant.IsVerified)
                    {
                        <span class="fx-outline-badge">Verified</span>
                    }
                </div>
                @* §5.5 — New Seller replaces the response line entirely; no percentage on the page in that state. *@
                @if (isNewSeller)
                {
                    <p class="fx-store-head__rate"><span class="fx-outline-badge">New seller</span></p>
                }
                else
                {
                    <p class="fx-store-head__rate">@MerchantResponseDisplay.Summary(response)</p>
                }
            </div>
        </div>
        <div class="fx-store-head__meta">
            <strong>@Model.Merchant.LiveListingCount listing@(Model.Merchant.LiveListingCount == 1 ? "" : "s")</strong>
            On Faed since @since
        </div>
    </div>

    <div style="margin-top:20px;">
        <partial name="_ShopBrowse" model="Model" />
    </div>

    @if (Model.Reviews is { Summary.HasReviews: true } reviews)
    {
        <section class="fx-detail-section">
            <h2>Buyer reviews</h2>
            <p class="fx-condition-note" style="margin-bottom:18px;">
                @reviews.Summary.AverageRating.ToString("0.0") out of 5 · @reviews.Summary.ReviewCount review@(reviews.Summary.ReviewCount == 1 ? "" : "s")
            </p>
            <div class="fx-grid fx-grid--3">
                @foreach (var review in reviews.Reviews)
                {
                    <div class="fx-card__body" style="border:1px solid var(--faed-border);border-radius:var(--faed-radius);">
                        <span class="fx-condition-note" aria-hidden="true">@ReviewDisplay.Stars(review.Rating)</span>
                        <p style="font-size:14px;margin:0;">
                            @(string.IsNullOrWhiteSpace(review.Comment) ? "Rating left without a written comment." : review.Comment)
                        </p>
                        <span class="fx-condition-note">@review.ReviewerLabel · @AmmanTime.FormatDate(review.CreatedAtUtc)</span>
                    </div>
                }
            </div>
        </section>
    }
</div>
