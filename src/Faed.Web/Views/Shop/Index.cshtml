@model ShopPageModel
@{
    ViewData["Title"] = "Shop";
}

<div class="faed-page faed-page--wide">
    <div class="faed-page__header faed-shop-header">
        <div>
            <p class="faed-kicker">Verified merchants &middot; Amman</p>
            <h1 class="faed-page__title">Shop Fashion Overstock</h1>
            <p class="faed-page__subtitle">Surplus and non-perfect stock from verified merchants in Amman, at retail and wholesale prices.</p>
        </div>
        <div class="faed-shop-header__trust" aria-label="Marketplace disclosure standard">
            <strong>Every live listing is reviewed.</strong>
            <span>Condition and discount reason are shown separately.</span>
        </div>
    </div>

    <partial name="_ShopBrowse" model="Model" />
</div>
