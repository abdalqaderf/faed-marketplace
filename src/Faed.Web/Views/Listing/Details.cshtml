@model PublicListingDetailView
@{
    ViewData["Title"] = Model.Title;

    var photos = Model.ProductPhotos;
    var hero = photos.Count > 0 ? photos[0] : null;
    var isNewSeller = MerchantResponseDisplay.IsNewSeller(Model.MerchantResponse);

    var warrantyLabel = Model.WarrantyType == WarrantyType.None
        ? "No warranty"
        : ListingStatusDisplay.WarrantyTypeLabel(Model.WarrantyType)
          + (Model.WarrantyMonths is { } m ? $" · {m} month{(m == 1 ? "" : "s")}" : "");

    var merchantInitials = string.Concat(Model.MerchantBusinessName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
    if (merchantInitials.Length == 0) { merchantInitials = "F"; }
}

<div class="fx-wrap fx-main">
    <nav class="fx-breadcrumb" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index">Faed</a> <span aria-hidden="true">/</span>
        <a asp-controller="Shop" asp-action="Index" asp-route-Category="@Model.CategorySlug">@Model.CategoryName</a> <span aria-hidden="true">/</span>
        <span aria-current="page">@Model.Title</span>
    </nav>

    <div class="fx-detail">
        <div class="fx-gallery">
            <div class="fx-photo" id="fx-hero">
                @if (hero is not null)
                {
                    <img src="/listing-images/@hero.Id" alt="@(hero.AltText ?? Model.Title)" />
                }
                else
                {
                    <span class="fx-photo__empty" aria-hidden="true">No product photo yet</span>
                }
                @* §5.4 — one condition stamp per screen, in the primary photo corner. *@
                @ConditionStamp.Render(Model.ConditionCode, large: true)
            </div>
            @if (photos.Count > 1)
            {
                <div class="fx-gallery__thumbs" role="group" aria-label="Choose product photo">
                    @for (var i = 0; i < photos.Count; i++)
                    {
                        var photo = photos[i];
                        <button type="button" class="fx-gallery__thumb @(i == 0 ? "is-active" : "")"
                                data-full-src="/listing-images/@photo.Id" data-full-alt="@(photo.AltText ?? Model.Title)">
                            <img src="/listing-images/@photo.Id" alt="" loading="lazy" />
                        </button>
                    }
                </div>
            }
        </div>

        <div class="fx-info">
            <span class="fx-info__meta">@Model.CategoryName &middot; Listed @AmmanTime.FormatDate(Model.PublishedAtUtc)</span>
            <h1 class="fx-info__title">@Model.Title</h1>

            @* §5.4 supporting text — plain-language condition name and reason, secondary colour, not a badge. *@
            <p class="fx-condition-note">@Model.ConditionName — @Model.ConditionDescription</p>

            <a class="fx-merchant-card" asp-controller="Store" asp-action="Index" asp-route-slug="@Model.MerchantSlug">
                <span class="fx-avatar fx-avatar--sm" aria-hidden="true">@merchantInitials</span>
                <span class="fx-merchant-card__body">
                    <span class="fx-merchant-card__name">
                        @Model.MerchantBusinessName
                        @if (isNewSeller)
                        {
                            <span class="fx-outline-badge">New seller</span>
                        }
                        else if (Model.MerchantIsVerified)
                        {
                            <span class="fx-outline-badge">Verified</span>
                        }
                    </span>
                    @if (!isNewSeller)
                    {
                        <span class="fx-merchant-card__rate">@MerchantResponseDisplay.Summary(Model.MerchantResponse)</span>
                    }
                </span>
                <span class="fx-merchant-card__arrow" aria-hidden="true">&rarr;</span>
            </a>

            <div class="fx-price fx-price--lg">
                @if (Model.RetailPrice is { } price)
                {
                    <span class="fx-price__now">@price.ToString("0.000") JD</span>
                    @if (Model.HasValidReferencePrice)
                    {
                        <span class="fx-price__was">@Model.ReferencePrice!.Value.ToString("0.000") JD</span>
                        <span class="fx-price__off">@Model.DiscountPercent% off</span>
                    }
                }
                else
                {
                    <span class="fx-price__now">Price on request</span>
                }
            </div>

            @if (Model.IsSoldOut)
            {
                <span class="fx-btn fx-btn--block is-disabled" aria-disabled="true">Sold out</span>
            }
            else
            {
                <a class="fx-btn fx-btn--block" asp-area="Buyer" asp-controller="Reservation" asp-action="Index" asp-route-slug="@Model.Slug">Reserve</a>
            }
            <p class="fx-cta-hint">
                Reserving holds this item for 12 hours. If the shop doesn’t confirm in that time, the
                reservation is cancelled and you’re notified. Payment is cash at the shop.
            </p>

            <div class="fx-reveal-note">
                The shop’s full address, pickup hours and phone number are shown once it confirms your reservation.
            </div>

            <dl class="fx-facts">
                <div><dt>Warranty</dt><dd>@warrantyLabel</dd></div>
                <div>
                    <dt>Original price</dt>
                    <dd>@(Model.ReferencePrice is { } refPrice ? $"{refPrice:0.000} JD" : "Not stated")</dd>
                </div>
                <div><dt>Quantity</dt><dd>@Model.AvailableUnits available</dd></div>
                <div><dt>Listed</dt><dd>@AmmanTime.FormatDate(Model.PublishedAtUtc)</dd></div>
            </dl>
        </div>
    </div>

    @if (Model.HasDisclosedIssues)
    {
        @* §5.6 — defect photos are never cut out: real background, rust DEFECT tag. *@
        <section class="fx-detail-section">
            <h2>Disclosed condition</h2>
            <p class="fx-detail-section__prose" style="margin-bottom:18px;">Photos of this exact unit, taken by the shop — not catalogue images.</p>
            <div class="fx-defect-grid">
                @foreach (var photo in Model.DefectPhotos)
                {
                    <figure class="fx-defect">
                        <div class="fx-defect__frame">
                            <img src="/listing-images/@photo.Id" alt="@(photo.AltText ?? "Disclosed defect")" loading="lazy" />
                            <span class="fx-defect__tag">DEFECT</span>
                        </div>
                        <figcaption>@(photo.AltText ?? "Disclosed defect on this unit.")</figcaption>
                    </figure>
                }
                @foreach (var photo in Model.PackagingPhotos)
                {
                    <figure class="fx-defect">
                        <div class="fx-defect__frame">
                            <img src="/listing-images/@photo.Id" alt="@(photo.AltText ?? "Packaging condition")" loading="lazy" />
                            <span class="fx-defect__tag">DEFECT</span>
                        </div>
                        <figcaption>@(photo.AltText ?? "Packaging condition.")</figcaption>
                    </figure>
                }
            </div>
        </section>
    }

    @* decision log #6 — description is a full-width text section below the photo/price block. *@
    <section class="fx-detail-section">
        <h2>Description</h2>
        <p class="fx-detail-section__prose">
            @(string.IsNullOrWhiteSpace(Model.Description)
                ? "The shop left no extra notes. The condition, warranty and photos above are the full disclosure."
                : Model.Description)
        </p>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            var hero = document.getElementById("fx-hero");
            if (!hero) { return; }
            var img = hero.querySelector("img");
            document.querySelectorAll(".fx-gallery__thumb").forEach(function (thumb) {
                thumb.addEventListener("click", function () {
                    if (!img) { return; }
                    img.src = thumb.getAttribute("data-full-src");
                    img.alt = thumb.getAttribute("data-full-alt") || "";
                    document.querySelectorAll(".fx-gallery__thumb").forEach(function (t) { t.classList.remove("is-active"); });
                    thumb.classList.add("is-active");
                });
            });
        })();
    </script>
}
