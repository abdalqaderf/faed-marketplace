@using Microsoft.AspNetCore.Identity
@using Faed.Web.Models.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav faed-account-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link faed-account-nav__user" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage account">
            <span class="faed-account-nav__avatar" aria-hidden="true">@((User.Identity?.Name ?? "A")[0].ToString().ToUpperInvariant())</span>
            <span class="faed-account-nav__label">Account</span>
        </a>
    </li>
    <li class="nav-item">
        <form class="faed-account-nav__form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link faed-account-nav__signout">Sign out</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link faed-account-nav__signin" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
    </li>
    <li class="nav-item">
        <a class="faed-btn faed-btn--primary faed-btn--nav" asp-area="Identity" asp-page="/Account/Register">Create account</a>
    </li>
}
</ul>
