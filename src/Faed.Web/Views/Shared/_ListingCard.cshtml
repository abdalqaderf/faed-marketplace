@model ListingCardView
@{
    var conditionName = Model.ConditionName;
}

<article class="fx-card">
    <a class="fx-photo" asp-controller="Listing" asp-action="Details" asp-route-slug="@Model.Slug"
       aria-label="View @Model.Title">
        @if (Model.PrimaryImageId is { } imageId)
        {
            <img src="/listing-images/@imageId" alt="@(Model.PrimaryImageAlt ?? Model.Title)" loading="lazy" />
        }
        else
        {
            <span class="fx-photo__empty" aria-hidden="true">No photo yet</span>
        }
        @* §5.4 — one condition stamp per screen, in the photo corner. Rust here is disclosure, not action. *@
        @ConditionStamp.Render(Model.ConditionCode)
    </a>

    <div class="fx-card__body">
        @* §5.4 supporting text: plain-language condition name, secondary colour, not a second badge. *@
        <span class="fx-condition-note">@conditionName</span>

        <h3 class="fx-card__title">
            <a asp-controller="Listing" asp-action="Details" asp-route-slug="@Model.Slug">@Model.Title</a>
        </h3>

        <a class="fx-card__merchant" asp-controller="Store" asp-action="Index" asp-route-slug="@Model.MerchantSlug">@Model.MerchantBusinessName</a>

        <div class="fx-price">
            @if (Model.EffectivePrice is { } price)
            {
                <span class="fx-price__now">@price.ToString("0.000") JD</span>
                @if (Model.HasValidReferencePrice)
                {
                    <span class="fx-price__was">@Model.ReferencePrice!.Value.ToString("0.000") JD</span>
                    <span class="fx-price__off">@Model.DiscountPercent% off</span>
                }
            }
            else
            {
                <span class="fx-price__now">Price on request</span>
            }
        </div>

        <span class="fx-card__stock">
            @(Model.IsSoldOut ? "Sold out" : $"{Model.AvailableUnits} available")
        </span>
    </div>
</article>
