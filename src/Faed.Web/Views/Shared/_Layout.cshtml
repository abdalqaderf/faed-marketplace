@using Faed.Domain.Identity
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Faed</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/faed.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Faed.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-0">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">Faed</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Merchant" asp-controller="Verification" asp-action="Index">Merchant Center</a>
                            </li>
                        }
                        @if (User.IsInRole(FaedRoles.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="MerchantVerification" asp-action="Index">Admin</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @{
            var statusMessage = TempData["StatusMessage"] as string;
            var errorMessage = TempData["ErrorMessage"] as string;
        }
        @if (!string.IsNullOrEmpty(statusMessage) || !string.IsNullOrEmpty(errorMessage))
        {
            <div class="faed-page" style="padding-block: 1rem 0;">
                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <div class="faed-alert faed-alert--success" role="status">@statusMessage</div>
                }
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="faed-alert faed-alert--error" role="alert">@errorMessage</div>
                }
            </div>
        }
        @RenderBody()
    </main>

    <footer class="border-top text-muted py-3 mt-4">
        <div class="faed-page" style="padding-block: 0;">
            &copy; 2026 Faed &mdash; <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
