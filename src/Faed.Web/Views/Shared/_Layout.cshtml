@using Faed.Web.Models.Identity
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? string.Empty;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var isIdentity = area.Equals("Identity", StringComparison.OrdinalIgnoreCase);
    var isIdentityManagePage = isIdentity
        && page.StartsWith("/Account/Manage", StringComparison.OrdinalIgnoreCase);
    var isIdentityStatePage = isIdentity
        && page.Equals("/Account/AccessDenied", StringComparison.OrdinalIgnoreCase);
    var isAuthPage = isIdentity
        && page.StartsWith("/Account/", StringComparison.OrdinalIgnoreCase)
        && !isIdentityManagePage
        && !isIdentityStatePage;
    var isOperationalWorkspace = area.Equals("Merchant", StringComparison.OrdinalIgnoreCase)
        || area.Equals("Admin", StringComparison.OrdinalIgnoreCase);
    var showMarketplaceSearch = !isOperationalWorkspace && !isIdentity;
    var navbarSearchQuery = string.IsNullOrEmpty(area) && controller.Equals("Shop", StringComparison.OrdinalIgnoreCase)
        ? Context.Request.Query["Q"].ToString()
        : string.Empty;
    // Reserve is a public, fully-redesigned screen (DESIGN-BRIEF.md §5.4a) even though its
    // controller sits under Areas/Buyer. Folder location is a routing convenience, not a
    // signal for the layout class — it renders with faed-public-page, never a workspace class.
    var isReservePage = area.Equals("Buyer", StringComparison.OrdinalIgnoreCase)
        && controller.Equals("Reservation", StringComparison.OrdinalIgnoreCase);
    var bodyClass = isIdentity
        ? isAuthPage
            ? "faed-identity-page faed-auth-page"
            : isIdentityManagePage
                ? "faed-identity-page faed-account-settings-page"
                : "faed-identity-page faed-identity-state-page"
        : isReservePage
            ? "faed-public-page"
            : !string.IsNullOrEmpty(area)
                ? $"faed-workspace-page faed-{area.ToLowerInvariant()}-page"
                : "faed-public-page";

    var isHome = string.IsNullOrEmpty(area) && controller.Equals("Home", StringComparison.OrdinalIgnoreCase);
    var isShopping = string.IsNullOrEmpty(area)
        && (controller is "Shop" or "Listing" or "Store");

    // Phase 12 — the five public screens (Home, Shop, Listing detail, Merchant storefront,
    // Reserve) carry the DESIGN-BRIEF.md §5.11 site chrome: wordmark left, three plain ink
    // links right, and a one-line footer. Workspaces and identity keep their own chrome.
    var isPublicSurface = (string.IsNullOrEmpty(area) && (isHome || isShopping)) || isReservePage;
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(FaedRoles.Admin);
    var isMerchant = User.IsInRole(FaedRoles.Merchant);

    // Phase 15 — unified navbar. "Sell on Faed" is a top-level destination for everyone who
    // does not already have a workspace link in its place (a signed-in merchant gets Merchant
    // Center instead, an admin gets Admin Workspace instead).
    var showSellOnFaed = !isAdmin && !isMerchant;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Faed</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Archivo+Narrow:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/faed.css" asp-append-version="true" />
</head>

<body class="@bodyClass">
    <a class="faed-skip-link" href="#main-content">Skip to main content</a>

@* Phase 15 (11 Sept 2026) — one navbar component for every page. Previously this branched
   between a plain fx-site-header (public pages only: wordmark + three text links, no search,
   no account state) and this richer faed-navbar (everywhere else). Clicking from Home into
   Sign in was visibly a different site. Now every route renders this header; only its content
   — primary links, search visibility, account cluster — still varies by auth state/role,
   never by which area of the app the visitor is in. See docs/DESIGN-BRIEF.md for the dated
   revision entry. The public-surface footer below is intentionally left as-is — the review
   that asked for this was about the navbar specifically, not the footer. *@
    <header class="faed-site-header">
        <nav class="navbar navbar-expand-lg faed-navbar" aria-label="Main navigation">
            <div class="faed-shell faed-navbar__inner">
                <a class="faed-wordmark" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Faed home">
                    <img class="faed-wordmark__mark" src="~/images/brand/logo-mark-64.png" width="64" height="64" alt="" aria-hidden="true" />
                    <span class="faed-wordmark__text">Faed</span>
                </a>

                @* Desktop primary destinations. The wordmark already returns Home, so Home is
                   a mobile-menu entry only and does not spend desktop navbar width. *@
                <div class="navbar-collapse collapse faed-navbar__collapse" id="faed-main-nav">
                    <ul class="navbar-nav faed-navbar__primary">
                        <li class="nav-item faed-navbar__primary-item--mobile">
                            <a class="nav-link @(isHome ? "is-active" : "")"
                               aria-current="@(isHome ? "page" : null)"
                               asp-area="" asp-controller="Home" asp-action="Index">
                                <span>Home</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isShopping ? "is-active" : "")"
                               aria-current="@(controller == "Shop" && string.IsNullOrEmpty(area) ? "page" : null)"
                               asp-area="" asp-controller="Shop" asp-action="Index">
                                <span>Shop</span>
                            </a>
                        </li>

                        @* Top-level "Sell on Faed" — the unified navbar's plain-header
                           predecessor showed this to every visitor; a signed-in merchant/admin
                           gets their workspace link in its place instead (below), never both. *@
                        @if (showSellOnFaed)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Merchant" asp-controller="Verification" asp-action="Apply">
                                    <span>Sell on Faed</span>
                                </a>
                            </li>
                        }

                        @* Workspace entry repeats here for the collapsed menu only. The
                           top-level control in the action cluster is hidden below lg and this
                           item is hidden from lg up, so exactly one is ever reachable. *@
                        @if (isSignedIn && isAdmin)
                        {
                            <li class="nav-item faed-navbar__primary-item--mobile">
                                <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">
                                    @FaedIcon.Render("shield", "faed-icon faed-navbar__primary-icon")
                                    <span>Admin Workspace</span>
                                </a>
                            </li>
                        }
                        else if (isSignedIn && isMerchant)
                        {
                            <li class="nav-item faed-navbar__primary-item--mobile">
                                <a class="nav-link" asp-area="Merchant" asp-controller="Verification" asp-action="Index">
                                    @FaedIcon.Render("storefront", "faed-icon faed-navbar__primary-icon")
                                    <span>Merchant Center</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                @if (showMarketplaceSearch)
                {
                    @* One search implementation: the existing Shop Q query parameter. On mobile
                       this wraps to its own full-width row instead of collapsing behind Menu. *@
                    <form class="faed-navbar-search" method="get" asp-area="" asp-controller="Shop" asp-action="Index"
                          role="search">
                        <label class="visually-hidden" for="faed-navbar-search-input">Search the marketplace</label>
                        @FaedIcon.Render("search", "faed-icon faed-navbar-search__leading")
                        <input id="faed-navbar-search-input" class="faed-navbar-search__input" type="search" name="Q"
                               value="@navbarSearchQuery" placeholder="Search products" autocomplete="off" />
                        <button class="faed-navbar-search__button" type="submit">
                            @FaedIcon.Render("search", "faed-icon faed-navbar-search__icon")
                            <span class="visually-hidden">Search the marketplace</span>
                        </button>
                    </form>
                }

                <div class="faed-navbar__actions">
                    <partial name="_LoginPartial" />

                    <button class="navbar-toggler faed-navbar__toggler" type="button" data-bs-toggle="collapse"
                            data-bs-target="#faed-main-nav" aria-controls="faed-main-nav" aria-expanded="false">
                        @FaedIcon.Render("menu", "faed-icon faed-navbar__toggler-icon")
                        <span class="visually-hidden">Open navigation</span>
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" role="main" tabindex="-1">
        @{
            var statusMessage = TempData["StatusMessage"] as string;
            var errorMessage = TempData["ErrorMessage"] as string;
        }
        @if (!string.IsNullOrEmpty(statusMessage) || !string.IsNullOrEmpty(errorMessage))
        {
            <div class="faed-page faed-flash-stack">
                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <div class="faed-alert faed-alert--success" role="status">
                        @FaedIcon.Render("check-circle", "faed-icon faed-alert__icon")
                        <span>@statusMessage</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="faed-alert faed-alert--error" role="alert">
                        @FaedIcon.Render("alert-circle", "faed-icon faed-alert__icon")
                        <span>@errorMessage</span>
                    </div>
                }
            </div>
        }
        @if (isAuthPage)
        {
            <div class="faed-auth-layout">
                <section class="faed-auth-content" aria-label="Faed account">
                    <p class="faed-auth-eyebrow">Secure Faed account</p>
                    @RenderBody()
                </section>
                <aside class="faed-auth-context" aria-label="Why use Faed">
                    <div class="faed-auth-context__inner">
                        <span class="faed-auth-context__mark" aria-hidden="true">
                            <img src="~/images/brand/logo-mark-glyph-64.png" width="64" height="64" alt="" />
                        </span>
                        <p class="faed-auth-context__eyebrow">Marketplace clarity</p>
                        <h2>Know more before you decide.</h2>
                        <p class="faed-auth-context__copy">
                            One Faed account gives you a clearer route through verified merchant
                            stock and the buying options available to you.
                        </p>
                        <ul class="faed-auth-context__facts">
                            <li>
                                @FaedIcon.Render("shield-check", "faed-icon faed-auth-context__icon")
                                <div>
                                    <strong>Verified merchants</strong>
                                    <small>Business review comes before marketplace access.</small>
                                </div>
                            </li>
                            <li>
                                @FaedIcon.Render("tag", "faed-icon faed-auth-context__icon")
                                <div>
                                    <strong>Clear listing context</strong>
                                    <small>The condition and the reason for the discount stay visible before you reserve.</small>
                                </div>
                            </li>
                            <li>
                                @FaedIcon.Render("eye", "faed-icon faed-auth-context__icon")
                                <div>
                                    <strong>Inspect before you pay</strong>
                                    <small>Reserve online, then check the item in person and pay cash at pickup.</small>
                                </div>
                            </li>
                        </ul>
                    </div>
                </aside>
            </div>
        }
        else
        {
            @RenderBody()
        }
    </main>

@if (isPublicSurface)
{
    <footer class="fx-site-footer">
        <div class="fx-wrap fx-site-footer__inner">
            <span class="fx-wordmark">Faed</span>
            <span class="fx-site-footer__line">Open-box and ex-display appliances and power tools &middot; Amman &middot; reserve online, pay cash at pickup</span>
        </div>
    </footer>
}
else
{
    <footer class="faed-site-footer">
        <div class="faed-shell faed-site-footer__grid">
            <div class="faed-site-footer__brand">
                <a class="faed-wordmark faed-wordmark--footer" asp-area="" asp-controller="Home" asp-action="Index">
                    <img class="faed-wordmark__mark" src="~/images/brand/logo-mark-glyph-64.png" width="64" height="64" alt="" aria-hidden="true" />
                    <span class="faed-wordmark__text">Faed</span>
                </a>
                <p>
                    Verified merchant stock with the condition and the reason for the discount
                    made clear before you reserve.
                </p>
            </div>
            <div>
                <h2 class="faed-site-footer__heading">Marketplace</h2>
                <ul class="faed-site-footer__links">
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-area="" asp-controller="Shop" asp-action="Index">Browse marketplace</a></li>
                </ul>
            </div>
            <div>
                <h2 class="faed-site-footer__heading">For merchants</h2>
                <ul class="faed-site-footer__links">
                    @if (!isAdmin)
                    {
                        <li><a asp-area="Merchant" asp-controller="Verification" asp-action="Apply">Apply to sell</a></li>
                        @if (isSignedIn)
                        {
                            <li><a asp-area="Merchant" asp-controller="Verification" asp-action="Index">Merchant Center</a></li>
                        }
                    }
                    @if (isAdmin)
                    {
                        <li><a asp-area="Admin" asp-controller="Home" asp-action="Index">Admin Workspace</a></li>
                    }
                </ul>
            </div>
            <div>
                <h2 class="faed-site-footer__heading">Information</h2>
                <ul class="faed-site-footer__links">
                    <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                    @if (!isSignedIn)
                    {
                        <li><a asp-area="Identity" asp-page="/Account/Login">Sign in</a></li>
                        <li><a asp-area="Identity" asp-page="/Account/Register">Create an account</a></li>
                    }
                </ul>
            </div>
        </div>
        <div class="faed-shell faed-site-footer__legal">
            <span>&copy; 2026 Faed</span>
            <span>Marketplace &middot; Amman, Jordan</span>
        </div>
    </footer>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
