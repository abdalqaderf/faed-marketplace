@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

@* The unhandled-exception fallback (Program.cs "app.UseExceptionHandler("/Home/Error")").
   Styled to match Views/Home/StatusCode.cshtml rather than the framework's default scaffold
   markup, and provides recovery without information leakage .
   No exception detail is shown here in any environment — only the request id, which is safe
   to disclose and helps support correlate a report. *@
<div class="faed-page">
    <div class="faed-empty faed-error-state">
        <span class="faed-error-state__code">Error</span>
        <h1 class="faed-empty__title">Something went wrong</h1>
        <p>
            We hit an unexpected error handling that request. Nothing was lost — try again in a
            moment, or head back to the marketplace.
        </p>
        @if (Model.ShowRequestId)
        {
            <p class="faed-field__hint">Reference: <code>@Model.RequestId</code></p>
        }
        <div class="faed-page__actions faed-page__actions--center">
            <a class="faed-btn faed-btn--primary" asp-controller="Home" asp-action="Index">Back to Faed</a>
            <a class="faed-btn faed-btn--ghost" asp-controller="Shop" asp-action="Index">Browse the shop</a>
        </div>
    </div>
</div>
