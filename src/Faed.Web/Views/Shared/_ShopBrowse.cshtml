@model IShopBrowsePageModel
@{
    var filters = Model.Filters;
    var result = Model.Result;
    var facets = result.Facets;
    var path = Context.Request.Path.Value ?? "/shop";
    var isStore = Model is StorePageModel;

    string BuildHref(IDictionary<string, string?> values)
    {
        var pairs = values
            .Where(pair => !string.IsNullOrWhiteSpace(pair.Value))
            .Select(pair => new KeyValuePair<string, string?>(pair.Key, pair.Value));
        return path + Microsoft.AspNetCore.Http.QueryString.Create(pairs);
    }

    string PageHref(int page)
    {
        var values = new Dictionary<string, string?>(filters.ToFilterRouteValues(), StringComparer.OrdinalIgnoreCase)
        {
            ["Page"] = page.ToString(System.Globalization.CultureInfo.InvariantCulture)
        };
        return BuildHref(values);
    }

    var priceValue = filters.MinPrice is { } mn && filters.MaxPrice is { } mx
        ? $"{mn:0}-{mx:0}"
        : filters.MinPrice is { } onlyMin
            ? $"{onlyMin:0}-"
            : "";
}

<section class="faed-shop-browse" aria-label="@(isStore ? "Store listings" : "Marketplace listings")">
    <form method="get" action="@path" class="fx-filters" role="search">
        <label class="fx-search">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="7" cy="7" r="5"/><path d="M11 11l4 4"/></svg>
            <span class="visually-hidden">@(isStore ? "Search this store" : "Search the marketplace")</span>
            <input type="search" name="Q" value="@filters.Q" placeholder="Search appliances and tools"
                   maxlength="@ShopFilterModel.MaxSearchTextLength" />
        </label>

        @if (!isStore)
        {
            <select class="fx-select" name="Category" aria-label="Category" onchange="this.form.submit()">
                <option value="">Category — all</option>
                @foreach (var option in facets.Categories)
                {
                    <option value="@option.Value" selected="@(string.Equals(filters.Category, option.Value, StringComparison.OrdinalIgnoreCase))">@option.Label</option>
                }
            </select>
        }

        <select class="fx-select" name="Condition" aria-label="Condition" onchange="this.form.submit()">
            <option value="">Condition — any</option>
            @foreach (var option in facets.Conditions)
            {
                <option value="@option.Value" selected="@(string.Equals(filters.Condition, option.Value, StringComparison.OrdinalIgnoreCase))">@option.Label</option>
            }
        </select>

        <select class="fx-select" aria-label="Price" onchange="fxApplyPrice(this)">
            <option value="">Price — any</option>
            <option value="20-50" selected="@(priceValue == "20-50")">20 – 50 JD</option>
            <option value="50-100" selected="@(priceValue == "50-100")">50 – 100 JD</option>
            <option value="100-150" selected="@(priceValue == "100-150")">100 – 150 JD</option>
            <option value="150-" selected="@(priceValue == "150-")">150 JD and up</option>
        </select>
        <input type="hidden" name="MinPrice" value="@(filters.MinPrice?.ToString("0", System.Globalization.CultureInfo.InvariantCulture))" />
        <input type="hidden" name="MaxPrice" value="@(filters.MaxPrice?.ToString("0", System.Globalization.CultureInfo.InvariantCulture))" />

        <div class="fx-sort">
            <span class="fx-sort__label">Sort</span>
            <select class="fx-select" name="Sort" aria-label="Sort listings" onchange="this.form.submit()">
                <option value="@ShopSort.Newest" selected="@(filters.Sort == ShopSort.Newest)">Newest</option>
                <option value="@ShopSort.PriceLowToHigh" selected="@(filters.Sort == ShopSort.PriceLowToHigh)">Price low–high</option>
                <option value="@ShopSort.PriceHighToLow" selected="@(filters.Sort == ShopSort.PriceHighToLow)">Price high–low</option>
            </select>
        </div>
    </form>

    <p class="fx-result-count">@result.TotalCount item@(result.TotalCount == 1 ? "" : "s")</p>

    @if (!result.HasResults)
    {
        <div class="fx-empty" style="margin-top:20px;">
            @if (filters.HasActiveFilters)
            {
                <div class="fx-empty__title">Nothing matches these filters</div>
                <p>Widen the price range, clear the condition, or search again.</p>
                <a class="fx-btn fx-btn--ghost" href="@path">Clear filters</a>
            }
            else if (isStore)
            {
                <div class="fx-empty__title">No live listings right now</div>
                <p>This shop has nothing published at the moment. Browse the rest of the marketplace instead.</p>
                <a class="fx-btn fx-btn--ghost" asp-controller="Shop" asp-action="Index">Open the shop</a>
            }
            else
            {
                <div class="fx-empty__title">Nothing is live yet</div>
                <p>Verified merchants are getting their first open-box and ex-display stock ready. Check back soon.</p>
            }
        </div>
    }
    else
    {
        <div class="fx-grid @(isStore ? "fx-grid--4" : "fx-grid--3")" style="margin-top:20px;">
            @foreach (var item in result.Items)
            {
                <partial name="_ListingCard" model="item" />
            }
        </div>

        @if (result.TotalPages > 1)
        {
            <nav class="fx-section-head" aria-label="Pagination" style="margin-top:28px;">
                <span class="fx-condition-note">Page @result.Page of @result.TotalPages</span>
                <span>
                    @if (result.Page > 1)
                    {
                        <a class="fx-section-head__link" href="@PageHref(result.Page - 1)" rel="prev">&larr; Previous</a>
                    }
                    @if (result.Page < result.TotalPages)
                    {
                        <a class="fx-section-head__link" href="@PageHref(result.Page + 1)" rel="next" style="margin-left:16px;">Next &rarr;</a>
                    }
                </span>
            </nav>
        }
    }
</section>

<script>
    function fxApplyPrice(select) {
        var form = select.form;
        var parts = (select.value || "").split("-");
        form.MinPrice.value = parts[0] || "";
        form.MaxPrice.value = (parts.length > 1 ? parts[1] : "") || "";
        form.submit();
    }
</script>
