@model IShopBrowsePageModel
@{
    var filters = Model.Filters;
    var result = Model.Result;
    var facets = result.Facets;
    var path = Context.Request.Path.Value ?? "/shop";
}

<div class="faed-shop-layout">
    <aside class="offcanvas-lg offcanvas-start faed-filter-panel" tabindex="-1" id="shop-filters" aria-labelledby="shop-filters-label">
        <div class="offcanvas-header faed-filter-panel__header">
            <h2 class="offcanvas-title faed-filter-panel__title" id="shop-filters-label">Filters</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#shop-filters" aria-label="Close filters"></button>
        </div>
        <div class="offcanvas-body faed-filter-panel__body">
            @if (filters.HasActiveFilters)
            {
                <a class="faed-filter-panel__clear" href="@path">Clear all filters</a>
            }

            <form method="get" action="@path" class="faed-filter-form">
                <div class="faed-filter-group">
                    <label class="faed-filter-group__label" for="filter-q">Search</label>
                    <input class="faed-input" type="search" id="filter-q" name="Q" value="@filters.Q" placeholder="Search listings" />
                </div>

                <fieldset class="faed-filter-group">
                    <legend class="faed-filter-group__label">Category</legend>
                    <div class="faed-filter-options">
                        <label class="faed-filter-option">
                            <input type="radio" name="Category" value="" checked="@string.IsNullOrEmpty(filters.Category)" />
                            <span>All categories</span>
                        </label>
                        @foreach (var option in facets.Categories)
                        {
                            <label class="faed-filter-option">
                                <input type="radio" name="Category" value="@option.Value" checked="@(filters.Category == option.Value)" />
                                <span>@option.Label</span>
                            </label>
                        }
                    </div>
                </fieldset>

                <fieldset class="faed-filter-group">
                    <legend class="faed-filter-group__label">Condition</legend>
                    <div class="faed-filter-options">
                        <label class="faed-filter-option">
                            <input type="radio" name="Condition" value="" checked="@string.IsNullOrEmpty(filters.Condition)" />
                            <span>Any condition</span>
                        </label>
                        @foreach (var option in facets.Conditions)
                        {
                            <label class="faed-filter-option">
                                <input type="radio" name="Condition" value="@option.Value" checked="@(filters.Condition == option.Value)" />
                                <span>@option.Label</span>
                            </label>
                        }
                    </div>
                </fieldset>

                <fieldset class="faed-filter-group">
                    <legend class="faed-filter-group__label">Why discounted</legend>
                    <div class="faed-filter-options">
                        <label class="faed-filter-option">
                            <input type="radio" name="Reason" value="" checked="@string.IsNullOrEmpty(filters.Reason)" />
                            <span>Any reason</span>
                        </label>
                        @foreach (var option in facets.DiscountReasons)
                        {
                            <label class="faed-filter-option">
                                <input type="radio" name="Reason" value="@option.Value" checked="@(filters.Reason == option.Value)" />
                                <span>@option.Label</span>
                            </label>
                        }
                    </div>
                </fieldset>

                @if (facets.Brands.Count > 0)
                {
                    <fieldset class="faed-filter-group">
                        <legend class="faed-filter-group__label">Brand</legend>
                        <div class="faed-filter-options">
                            <label class="faed-filter-option">
                                <input type="radio" name="Brand" value="" checked="@string.IsNullOrEmpty(filters.Brand)" />
                                <span>Any brand</span>
                            </label>
                            @foreach (var option in facets.Brands)
                            {
                                <label class="faed-filter-option">
                                    <input type="radio" name="Brand" value="@option.Value" checked="@(filters.Brand == option.Value)" />
                                    <span>@option.Label</span>
                                </label>
                            }
                        </div>
                    </fieldset>
                }

                @if (facets.Sizes.Count > 0)
                {
                    <fieldset class="faed-filter-group">
                        <legend class="faed-filter-group__label">Size</legend>
                        <div class="faed-filter-options">
                            <label class="faed-filter-option">
                                <input type="radio" name="Size" value="" checked="@string.IsNullOrEmpty(filters.Size)" />
                                <span>Any size</span>
                            </label>
                            @foreach (var option in facets.Sizes)
                            {
                                <label class="faed-filter-option">
                                    <input type="radio" name="Size" value="@option.Value" checked="@(filters.Size == option.Value)" />
                                    <span>@option.Label</span>
                                </label>
                            }
                        </div>
                    </fieldset>
                }

                @if (facets.Colors.Count > 0)
                {
                    <fieldset class="faed-filter-group">
                        <legend class="faed-filter-group__label">Colour</legend>
                        <div class="faed-filter-options">
                            <label class="faed-filter-option">
                                <input type="radio" name="Color" value="" checked="@string.IsNullOrEmpty(filters.Color)" />
                                <span>Any colour</span>
                            </label>
                            @foreach (var option in facets.Colors)
                            {
                                <label class="faed-filter-option">
                                    <input type="radio" name="Color" value="@option.Value" checked="@(filters.Color == option.Value)" />
                                    <span>@option.Label</span>
                                </label>
                            }
                        </div>
                    </fieldset>
                }

                <fieldset class="faed-filter-group">
                    <legend class="faed-filter-group__label">Price (JOD)</legend>
                    <div class="faed-filter-price-row">
                        <label class="visually-hidden" for="filter-min-price">Minimum price</label>
                        <input class="faed-input" type="number" min="0" step="0.001" id="filter-min-price" name="MinPrice" value="@filters.MinPrice" placeholder="Min" />
                        <span aria-hidden="true">&ndash;</span>
                        <label class="visually-hidden" for="filter-max-price">Maximum price</label>
                        <input class="faed-input" type="number" min="0" step="0.001" id="filter-max-price" name="MaxPrice" value="@filters.MaxPrice" placeholder="Max" />
                    </div>
                </fieldset>

                <fieldset class="faed-filter-group">
                    <legend class="faed-filter-group__label">Availability</legend>
                    <div class="faed-filter-options">
                        <label class="faed-filter-option">
                            <input type="radio" name="Channel" value="@MarketplaceChannel.All" checked="@(filters.Channel == MarketplaceChannel.All)" />
                            <span>All listings</span>
                        </label>
                        <label class="faed-filter-option">
                            <input type="radio" name="Channel" value="@MarketplaceChannel.RetailOnly" checked="@(filters.Channel == MarketplaceChannel.RetailOnly)" />
                            <span>Retail available</span>
                        </label>
                        <label class="faed-filter-option">
                            <input type="radio" name="Channel" value="@MarketplaceChannel.WholesaleOnly" checked="@(filters.Channel == MarketplaceChannel.WholesaleOnly)" />
                            <span>Wholesale available</span>
                        </label>
                    </div>
                    <span class="faed-field__hint">A listing can offer both — these show what's available, not an exclusive choice.</span>
                </fieldset>

                <input type="hidden" name="Sort" value="@filters.Sort" />
                <button type="submit" class="faed-btn faed-btn--primary faed-filter-form__submit">Apply filters</button>
            </form>
        </div>
    </aside>

    <section class="faed-shop-results">
        <div class="faed-sort-bar">
            <button type="button" class="faed-btn faed-btn--ghost faed-btn--sm faed-filter-toggle" data-bs-toggle="offcanvas" data-bs-target="#shop-filters" aria-controls="shop-filters">
                <span>Filters</span>
                @if (filters.ActiveFilterCount > 0)
                {
                    <span class="faed-filter-toggle__count" aria-label="@(filters.ActiveFilterCount == 1 ? "1 filter applied" : $"{filters.ActiveFilterCount} filters applied")">@filters.ActiveFilterCount</span>
                }
            </button>
            <p class="faed-sort-bar__count">
                @result.TotalCount @(result.TotalCount == 1 ? "listing" : "listings")
            </p>
            <form method="get" action="@path" class="faed-sort-bar__sort">
                @* "Sort" is deliberately excluded: this form's own <select name="Sort"> already
                   supplies it, and a hidden input with the same name would submit alongside it —
                   model binding takes the first value in the query string, so the newly
                   selected option would silently lose to the stale hidden one. *@
                @foreach (var pair in filters.ToFilterRouteValues())
                {
                    if (pair.Key != "Sort" && !string.IsNullOrEmpty(pair.Value))
                    {
                        <input type="hidden" name="@pair.Key" value="@pair.Value" />
                    }
                }
                <label class="visually-hidden" for="sort-select">Sort by</label>
                <select class="faed-select" id="sort-select" name="Sort" onchange="this.form.submit()">
                    <option value="@ShopSort.Newest" selected="@(filters.Sort == ShopSort.Newest)">Newest</option>
                    <option value="@ShopSort.PriceLowToHigh" selected="@(filters.Sort == ShopSort.PriceLowToHigh)">Price: low to high</option>
                    <option value="@ShopSort.PriceHighToLow" selected="@(filters.Sort == ShopSort.PriceHighToLow)">Price: high to low</option>
                </select>
            </form>
        </div>

        @if (!result.HasResults)
        {
            <div class="faed-empty">
                @if (filters.HasActiveFilters)
                {
                    <div class="faed-empty__title">No listings match your filters</div>
                    <p>Try a wider price range, a different category, or clear your filters.</p>
                    <a class="faed-btn faed-btn--ghost" href="@path">Clear filters</a>
                }
                else
                {
                    <div class="faed-empty__title">No listings here yet</div>
                    <p>Approved merchants are getting their stock ready. Check back soon.</p>
                }
            </div>
        }
        else
        {
            <div class="faed-product-grid">
                @foreach (var item in result.Items)
                {
                    <partial name="_ListingCard" model="item" />
                }
            </div>

            @if (result.TotalPages > 1)
            {
                <nav class="faed-pagination" aria-label="Pagination">
                    @if (result.Page > 1)
                    {
                        <a class="faed-btn faed-btn--ghost faed-btn--sm" asp-all-route-data="@filters.ToFilterRouteValues()" asp-route-Page="@(result.Page - 1)">Previous</a>
                    }
                    <span class="faed-pagination__status">Page @result.Page of @result.TotalPages</span>
                    @if (result.Page < result.TotalPages)
                    {
                        <a class="faed-btn faed-btn--ghost faed-btn--sm" asp-all-route-data="@filters.ToFilterRouteValues()" asp-route-Page="@(result.Page + 1)">Next</a>
                    }
                </nav>
            }
        }
    </section>
</div>
