@{
    ViewData["Title"] = "Privacy";
}

@* Reachable from the footer on every page. Previously the scaffolded placeholder text — a
   real, honest summary belongs here instead of an unfinished page a visitor can click into,
   since every reachable shell screen must visually fit Faed. Content is a plain-language
   summary of the practices this application already implements — it does not add or imply
   any handling this repository does not already build. *@
<div class="faed-page faed-privacy-page">
    <div class="faed-page__header">
        <div>
            <h1 class="faed-page__title">Privacy</h1>
            <p class="faed-page__subtitle">A plain-language summary of how Faed handles your information.</p>
        </div>
    </div>

    <div class="faed-panel">
        <h2 class="faed-panel__title">What we collect</h2>
        <p>
            To run your account and transactions, Faed collects the account details you provide
            (name, email, phone), the addresses and contact details you give at checkout, and
            the record of orders, offers, deals, disputes and reviews you take part in. We only
            collect what a current feature actually needs.
        </p>
    </div>

    <div class="faed-panel">
        <h2 class="faed-panel__title">Merchant verification documents</h2>
        <p>
            Documents a merchant submits to verify their business are kept in private storage.
            They are never shown publicly and are visible only to Faed administrators reviewing
            the application — every access is authorized and recorded.
        </p>
    </div>

    <div class="faed-panel">
        <h2 class="faed-panel__title">Dispute evidence</h2>
        <p>
            Photos or files attached to a dispute are private to the people involved in that
            transaction — the buyer, the selling merchant, and Faed administrators reviewing
            the dispute. They are never public.
        </p>
    </div>

    <div class="faed-panel">
        <h2 class="faed-panel__title">How your information is used</h2>
        <p>
            Your information is used to operate the marketplace: creating and fulfilling
            orders, running merchant verification and listing moderation, resolving disputes,
            and showing your own order and review history back to you. Faed does not sell your
            personal information.
        </p>
    </div>

    <div class="faed-panel">
        <h2 class="faed-panel__title">Questions</h2>
        <p>
            This page is a summary, not a legal document. If you have a question about your
            data, contact Faed support.
        </p>
    </div>
</div>
