@model HomePageView
@{
    ViewData["Title"] = "Open-box and ex-display appliances and power tools in Amman";

    // §5.11 zero-decoration: stroke-SVG category glyphs, one consistent style, never emoji.
    // Phase 20 addendum (12 Sept 2026): the previous shapes (a magnifying-glass-like glyph, a
    // squat body-plus-handle, a basket) read as a crosshair, a spray can and a basket rather
    // than their categories on review.
    // Phase 21 (12 Sept 2026, §5.19): redrawn again on a 24x24/1.6-stroke canvas — the
    // convention FaedIcon.cs already uses sitewide — as part of the "Shop by category" card
    // redesign, closing the gap between this page-local glyph set and the shared icon system.
    // Phase 21 addendum (12 Sept 2026): direct feedback that none of the three read clearly at
    // the chip's actual size. All three redrawn again, rendered at the real 28x28 size before
    // shipping (same discipline as the earlier vacuum-icon fix) — home-cleaning in particular
    // went from a diagonal-stick silhouette that read as a golf club to an upright body with a
    // curved handle and wheeled foot, which reads as a vacuum cleaner. See §5.19 addendum.
    Func<string, string> CategoryGlyph = slug => slug switch
    {
        "home-cleaning" => "<rect x='9.6' y='4.2' width='4' height='11.4' rx='2'/><path d='M11.6 4.4c1.3-1.9 3.3-2.9 5.7-3'/><path d='M16.3 1.1 18.8 1.6'/><rect x='6.3' y='15.6' width='11.4' height='2.6' rx='1.3'/><circle cx='8.4' cy='19.4' r='1'/><circle cx='15.6' cy='19.4' r='1'/>",
        "power-tools" => "<rect x='3' y='9.5' width='10.5' height='5' rx='1.4'/><path d='M6.2 14.5v5a1.3 1.3 0 0 1-1.3 1.3h-.8A1.3 1.3 0 0 1 2.8 19.5v-3.6'/><path d='M13.5 10.6h2.2l4-2v7l-4-2h-2.2'/><path d='M19.7 12.3v2.4'/>",
        _ => "<path d='M8 3.6h8l1 5.8H7L8 3.6Z'/><path d='M6.6 9.4h10.8l-1.3 9.4a2.3 2.3 0 0 1-2.3 2H10.2a2.3 2.3 0 0 1-2.3-2L6.6 9.4Z'/><path d='M9 13h6M9.6 16h4.8'/><rect x='5.5' y='20.4' width='13' height='2' rx='0.6'/>",
    };
}

@* 2026-09-11 revision — a real hero: headline, subtext, two CTAs and a trust strip, plus a
   decorative showcase built from the same photo-tile + condition-stamp components used on a
   real listing card, so the intro ties to the disclosure premise instead of a generic banner
   photo. The visual half is presentational only (aria-hidden).
   Phase 15 (11 Sept 2026) — the showcase is now a single hung tag (a hole + a length of
   string) over a faint blueprint-grid ground, replacing the earlier blob + two overlapping
   cards, which read as a generic SaaS/AI-generated collage on review.
   Phase 17 (11 Sept 2026, same day) — that hung tag was itself a photo tile for ONE listing.
   Feedback was that the hero visual should show the marketplace's whole idea — several kinds
   of graded, open-box goods — not a single product, so the showcase is now a wider "trade
   counter" scene panel.
   Phase 20 (11 Sept 2026) — the product owner supplied the real photo
   (wwwroot/images/home/home-hero.png); the CategoryGlyph fallback is replaced with the actual
   <img class="fx-hero__scene-photo">. *@
<section class="fx-hero">
    <div class="fx-wrap fx-hero__grid">
        <div class="fx-hero__content">
            <span class="fx-hero__eyebrow">Amman &middot; Open-box &amp; ex-display</span>
            <h1 class="fx-hero__title">Appliances and power tools that show their whole story.</h1>
            <p class="fx-hero__tag">
                Open-box and ex-display appliances and power tools in Amman. Every listing shows its
                condition and why the price dropped. Reserve online, inspect and pay cash at pickup.
            </p>
            <div class="fx-hero__actions">
                <a class="fx-btn" asp-controller="Shop" asp-action="Index">Browse the shop</a>
                <a class="fx-btn fx-btn--ghost" asp-area="Merchant" asp-controller="Verification" asp-action="Apply">Sell on Faed</a>
            </div>
            <ul class="fx-hero__facts">
                <li>@FaedIcon.Render("shield-check") <span>Verified Amman merchants only</span></li>
                <li>@FaedIcon.Render("tag") <span>Condition and discount reason disclosed on every listing</span></li>
                <li>@FaedIcon.Render("eye") <span>Inspect in person, pay cash at pickup</span></li>
            </ul>
        </div>
        <div class="fx-hero__visual" aria-hidden="true">
            <figure class="fx-hero__scene">
                <div class="fx-hero__scene-frame">
                    <img class="fx-hero__scene-photo" src="~/images/home/home-hero.png" alt="" />
                </div>
                <span class="fx-hero__scene-tag">
                    <span class="fx-hero__scene-hole"></span>
                    Every item, graded &amp; disclosed
                </span>
            </figure>
        </div>
    </div>
</section>

<div class="fx-wrap fx-main">
    @if (Model.Categories.Count > 0)
    {
        <div class="fx-section-head">
            <h2>Shop by category</h2>
        </div>
        <div class="fx-cat-grid">
            @foreach (var category in Model.Categories)
            {
                <a class="fx-cat-card" asp-controller="Shop" asp-action="Index" asp-route-Category="@category.Slug">
                    <span class="fx-cat-card__top">
                        <span class="fx-cat-card__icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CategoryGlyph(category.Slug))</svg>
                        </span>
                        @* Visual affordance only, not a separate control — the whole tile is the link. *@
                        <span class="fx-cat-card__arrow" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                        </span>
                    </span>
                    <span>
                        <span class="fx-cat-card__name">@category.Name</span>
                        <span class="fx-cat-card__count">@category.LiveListingCount item@(category.LiveListingCount == 1 ? "" : "s")</span>
                    </span>
                </a>
            }
        </div>
    }

    <div class="fx-section-head">
        <h2>Newest on Faed</h2>
        <a class="fx-section-head__link" asp-controller="Shop" asp-action="Index">Browse the shop &rarr;</a>
    </div>

    @if (Model.FeaturedListings.Count == 0)
    {
        <div class="fx-empty">
            <div class="fx-empty__title">Nothing is live yet</div>
            <p>Verified merchants are getting their first open-box and ex-display stock ready. Check back soon.</p>
            <a class="fx-btn fx-btn--ghost" asp-controller="Shop" asp-action="Index">Open the shop</a>
        </div>
    }
    else
    {
        <div class="fx-grid fx-grid--3">
            @foreach (var item in Model.FeaturedListings)
            {
                <partial name="_ListingCard" model="item" />
            }
        </div>
    }
</div>
